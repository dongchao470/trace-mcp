diff --git a/TraceCore/Models/SSECompletionPolicy.swift b/TraceCore/Models/SSECompletionPolicy.swift
new file mode 100644
--- /dev/null
+++ b/TraceCore/Models/SSECompletionPolicy.swift
@@ -0,0 +1,36 @@
+import Foundation
+
+/// HTTP completion, not merely receiving headers, decides whether a stream ended normally.
+public enum SSECompletionPolicy {
+    public struct Outcome: Sendable {
+        public let succeeded: Bool
+        public let reason: String
+    }
+
+    public static func outcome(responseComplete: Bool, statusCode: Int?) -> Outcome {
+        guard responseComplete else {
+            return Outcome(succeeded: false, reason: "upstream_closed_before_response_end")
+        }
+        guard let statusCode else {
+            return Outcome(succeeded: false, reason: "missing_response_status")
+        }
+        guard (200 ..< 300).contains(statusCode) else {
+            return Outcome(succeeded: false, reason: "http_\(statusCode)")
+        }
+        return Outcome(succeeded: true, reason: "response_completed")
+    }
+
+    public static func description(for reason: String?) -> String {
+        switch reason {
+        case "response_completed": return "响应正常结束"
+        case "upstream_closed_before_response_end": return "上游提前断开，未收到完整响应结束"
+        case "missing_response_status": return "未收到有效的 HTTP 响应"
+        case "client_disconnected": return "客户端关闭了连接"
+        case "stream_interrupted": return "流传输被中断"
+        case nil, "": return "旧记录未保存结束原因，无法仅凭 Closed 判断是否异常"
+        case let value?:
+            if value.hasPrefix("http_") { return "HTTP 错误：\(value.dropFirst(5))" }
+            return value
+        }
+    }
+}
