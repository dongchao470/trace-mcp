会话"),
        ], required: ["confirm"])
    )

    // MARK: - Schema helpers

    private static func schema(_ properties: [String: JSONValue], required: [String] = []) -> JSONValue {
        var object: [String: JSONValue] = [
            "type": .string("object"),
            "properties": .object(properties),
        ]
        if !required.isEmpty {
            object["required"] = .array(required.map { JSONValue.string($0) })
        }
        return .object(object)
    }

    private static func stringField(_ description: String? = nil) -> JSONValue {
        var object: [String: JSONValue] = ["type": .string("string")]
        if let description {
            object["description"] = .string(description)
        }
        return .object(object)
    }

    private static func enumField(_ values: [String]) -> JSONValue {
        .object([
            "type": .string("string"),
            "enum": .array(values.map { JSONValue.string($0) }),
        ])
    }

    private static func intField(_ description: String? = nil, defaultValue: Int? = nil, maximum: Int? = nil) -> JSONValue {
        var object: [String: JSONValue] = ["type": .string("integer")]
        if let description {
            object["description"] = .string(description)
        }
        if let defaultValue {
            object["default"] = .number(Double(defaultValue))
        }
        if let maximum {
            object["maximum"] = .number(Double(maximum))
        }
        return .object(object)
    }

    private static func boolField(_ description: String? = nil, defaultValue: Bool? = nil) -> JSONValue {
        var object: [String: JSONValue] = ["type": .string("boolean")]
        if let description {
            object["description"] = .string(description)
        }
        if let defaultValue {
            object["default"] = .bool(defaultValue)
        }
        return .object(object)
    }

    private static func objectField(_ description: String) -> JSONValue {
        .object(["type": .string("object"), "description": .string(description)])
    }

    // MARK: - Dispatch

    public func call(tool: String, arguments: JSONValue) async -> JSONValue {
        do {
            let result = try await run(tool: tool, arguments: arguments)
            return .object([
                "content": .array([.object(["type": .string("text"), "text": .string(result.data(pretty: true).utf8String ?? "{}")])]),
                "isError": .bool(false),
            ])
        } catch let error as MCPError {
            return failure(error.message)
        } catch {
            return failure(error.localizedDescription)
        }
    }

    private func failure(_ message: String) -> JSONValue {
        .object([
            "content": .array([.object(["type": .string("text"), "text": .string(message)])]),
            "isError": .bool(true),
        ])
    }

    private func run(tool: String, arguments: JSONValue) async throws -> JSONValue {
        switch tool {
        case "trace_status":
            try await status(arguments)
        case "list_sessions":
            try await listSessions(arguments)
        case "list_requests":
            try await listRequests(arguments)
        case "get_request":
            try await getRequest(arguments)
        case "search_requests":
            try await searchRequests(arguments)
        case "replay_request":
            try await replayRequest(arguments)
        case "list_rewrite_rules":
            try await listRewriteRules(arguments)
        case "clear_requests":
            try await clearRequests(arguments)
        default:
            throw MCPError.toolFailure("未知工具：\(tool)")
        }
    }

    // MARK: - Tools

    private func status(_: JSONValue) async throws -> JSONValue {
        let requests = (try? await storage.loadRequests()) ?? []
        let sessions = (try? await storage.loadSessions()) ?? []
        let rules = (try? await storage.loadRewriteRules()) ?? []
        let runtime = TraceMCPServer.shared.status
        let info = Bundle.main.infoDictionary ?? [:]
        return .object([
            "host": .string(runtime.host),
            "running": .bool(runtime.isRunning),
            "port": .number(Double(runtime.port)),
            "uptime_seconds": .number(runtime.uptime),
            "app_version": .string(info["CFBundleShortVersionString"] as? String ?? "unknown"),
            "app_build": .string(info["CFBundleVersion"] as? String ?? "unknown"),
            "bundle_id": .string(info["CFBundleIdentifier"] as? String ?? "unknown"),
            "request_count": .number(Double(requests.count)),
            "session_count": .number(Double(sessions.count)),
            "rewrite_rule_count": .number(Double(rules.count)),
            "latest_request_at": requests.max(by: { $0.timestamp < $1.timestamp }).map { .string(iso($0.timestamp)) } ?? .null,
        ])
    }

