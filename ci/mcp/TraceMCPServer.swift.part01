//
//  TraceMCPServer.swift
//  TraceCore
//
//  Loopback MCP (JSON-RPC over HTTP) endpoint hosted by the app or the tunnel extension.
//

import Foundation
import Network
import OSLog

public struct TraceMCPStatus: Sendable {
    public let host: String
    public let isRunning: Bool
    public let port: UInt16
    public let uptime: TimeInterval

    public init(host: String, isRunning: Bool, port: UInt16, uptime: TimeInterval) {
        self.host = host
        self.isRunning = isRunning
        self.port = port
        self.uptime = uptime
    }
}

private let mcpLog = TraceLog.make(module: "TraceCore", category: "MCP")

public final class TraceMCPServer: @unchecked Sendable {
    public static let shared = TraceMCPServer()

    public static let defaultPort: UInt16 = 6180

    private struct State {
        var listener: NWListener?
        var host: String = "idle"
        var port: UInt16 = 0
        var startedAt: Date?
        var lastError: String?
    }

    private let lock = NSLock()
    private var state = State()
    private let queue = DispatchQueue(label: "com.justin.trace.mcp.server", qos: .utility)

    private init() {}

    // MARK: - Lifecycle

    public var status: TraceMCPStatus {
        lock.lock()
        defer { lock.unlock() }
        return TraceMCPStatus(
            host: state.host,
            isRunning: state.listener != nil,
            port: state.port,
            uptime: state.startedAt.map { Date().timeIntervalSince($0) } ?? 0
        )
    }

    public var lastError: String? {
        lock.lock()
        defer { lock.unlock() }
        return state.lastError
    }

    /// Starts the loopback listener once; repeated calls with the same port are no-ops.
    public func start(port: UInt16 = TraceMCPServer.defaultPort, host: String) {
        lock.lock()
        if let listener = state.listener {
            let samePort = state.port == port
            lock.unlock()
            if !samePort {
                stop()
                start(port: port, host: host)
            }
            return
        }
        state.host = host
        state.port = port
        state.lastError = nil
        lock.unlock()

        guard let nwPort = NWEndpoint.Port(rawValue: port) else {
            record(error: "非法端口 \(port)")
            return
        }

        let parameters = NWParameters.tcp
        parameters.allowLocalEndpointReuse = true
        parameters.requiredLocalEndpoint = .hostPort(host: .ipv4(.loopback), port: nwPort)

        do {
            let listener = try NWListener(using: parameters)
            listener.stateUpdateHandler = { [weak self] newState in
                guard let self else { return }
                switch newState {
                case .ready:
                    mcpLog.info("mcp.listener ready port=\(port, privacy: .public) host=\(host, privacy: .public)")
                case let .failed(error):
                    self.record(error: "listener failed: \(error.localizedDescription)")
                    self.stopListener()
                case .cancelled:
                    break
                default:
                    break
                }
            }
            listener.newConnectionHandler = { [weak self] connection in
                guard let self else {
                    connection.cancel()
                    return
                }
                guard Self.isLoopback(connection.endpoint) else {
                    connection.cancel()
                    return
                }
                MCPHTTPConnection(connection: connection, queue: queue).start()
            }
            lock.lock()
            state.listener = listener
            state.startedAt = Date()
            lock.unlock()
            listener.start(queue: queue)
            mcpLog.info("mcp.start port=\(port, privacy: .public) host=\(host, privacy: .public)")
        } catch {
            record(error: "listener init failed: \(error.localizedDescription)")
        }
    }

    public func stop() {
        stopListener()
    }

    private func stopListener() {
        lock.lock()
        let listener = state.listener
        state.listener = nil
        state.startedAt = nil
        state.host = "idle"
        state.port = 0
        lock.unlock()
        listener?.cancel()
    }

    private func record(error: String) {
        lock.lock()
        state.lastError = error
        lock.unlock()
        mcpLog.error("mcp.error \(error, privacy: .public)")
    }

    private static func isLoopback(_ endpoint: NWEndpoint) -> Bool {
        guard case let .hostPort(host, _) = endpoint else {
            return false
        }
        switch host {
        case let .ipv4(address):
            return address == .loopback
        case let .ipv6(address):
            return address == .loopback
        case let .name(name, _):
            return name == "localhost"
        @unknown default:
            return false
        }
    }

    // MARK: - JSON-RPC

    /// Returns nil when the request is a notification (HTTP 202, empty body).
    public func handleRPC(_ body: Data) async -> Data? {
        guard let request = try? MCPRPCRequest.decode(body) else {
            return Self.encodeError(id: .null, code: .parseError, message: "无法解析 JSON-RPC 请求")
        }

        if request.method.hasPrefix("notifications/") {
            ret