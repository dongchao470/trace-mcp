//
//  TraceMCPTools.swift
//  TraceCore
//
//  Tool surface exposed by the Trace MCP server.
//

import AsyncHTTPClient
import Foundation
import NIOCore

public struct TraceMCPToolDefinition: Sendable {
    public let name: String
    public let description: String
    public let inputSchema: JSONValue

    public init(name: String, description: String, inputSchema: JSONValue) {
        self.name = name
        self.description = description
        self.inputSchema = inputSchema
    }
}

/// Serializes every tool call; storage handles are not re-entrant.
public actor TraceMCPDispatcher {
    public static let shared = TraceMCPDispatcher()

    private let storage = AppGroupStorage.shared
    private let isoFormatter: ISO8601DateFormatter = {
        let formatter = ISO8601DateFormatter()
        formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
        return formatter
    }()

    public init() {}

    // MARK: - Definitions

    public nonisolated var tools: [TraceMCPToolDefinition] { TraceMCPDispatcher.definitions }

    private static let definitions: [TraceMCPToolDefinition] = [
        statusDefinition,
        sessionsDefinition,
        requestsDefinition,
        requestDetailDefinition,
        searchDefinition,
        replayDefinition,
        rulesDefinition,
        clearDefinition,
    ]

    // MARK: - Definitions

    private static let statusDefinition = TraceMCPToolDefinition(
        name: "trace_status",
        description: "Trace 抓包状态：进程宿主、版本、端口、运行时长、抓包与会话数量、重写规则数量。",
        inputSchema: schema([:])
    )

    private static let sessionsDefinition = TraceMCPToolDefinition(
        name: "list_sessions",
        description: "列出抓包会话（最近的在前）。返回 id、名称、开始时间、请求数、是否进行中。",
        inputSchema: schema(["limit": intField(defaultValue: 20, maximum: 200)])
    )

    private static let requestsDefinition = TraceMCPToolDefinition(
        name: "list_requests",
        description: "按条件列出抓到的请求，返回精简条目（id/method/url/status/duration 等），用于浏览与筛选。",
        inputSchema: schema([
            "session_id": stringField("只看某个会话"),
            "host": stringField("域名包含匹配，例如 api.example.com"),
            "url_contains": stringField("URL 包含匹配"),
            "method": stringField("GET/POST 等"),
            "status": intField("状态码精确匹配"),
            "status_min": intField(),
            "status_max": intField(),
            "only_errors": boolField("只要 4xx/5xx 或无状态码"),
            "limit": intField(defaultValue: 50, maximum: 500),
            "offset": intField(defaultValue: 0),
            "sort": enumField(["newest", "oldest", "slowest"]),
        ])
    )

    private static let requestDetailDefinition = TraceMCPToolDefinition(
        name: "get_request",
        description: "读取单个请求的完整详情：请求/响应头、正文（文本优先，二进制给大小）、时序、TLS、命中的规则。",
        inputSchema: schema([
            "id": stringField("请求 UUID"),
            "max_body_bytes": intField(defaultValue: 65536, maximum: 1048576),
        ], required: ["id"])
    )

    private static let searchDefinition = TraceMCPToolDefinition(
        name: "search_requests",
        description: "在 URL、请求头/响应头或正文中搜索关键字，返回匹配的请求条目。",
        inputSchema: schema([
            "query": stringField(),
            "scope": enumField(["all", "url", "headers", "body"]),
            "session_id": stringField(),
            "limit": intField(defaultValue: 50, maximum: 500),
        ], required: ["query"])
    )

    private static let replayDefinition = TraceMCPToolDefinition(
        name: "replay_request",
        description: "重放一条已抓到的请求，可选覆盖请求头/请求体，返回新记录 id、状态码、耗时与响应预览。",
        inputSchema: schema([
            "id": stringField("被重放的请求 UUID"),
            "headers": objectField("要覆盖或新增的请求头（字符串值）"),
            "body": stringField("用这段文本替换请求体"),
            "timeout_seconds": intField(defaultValue: 30, maximum: 120),
            "store": boolField("是否把重放结果写回抓包列表", defaultValue: true),
        ], required: ["id"])
    )

    private static let rulesDefinition = TraceMCPToolDefinition(
        name: "list_rewrite_rules",
        description: "列出重写规则（只读）：名称、是否启用、规则类型、匹配描述、动作类型、命中次数。",
        inputSchema: schema([
            "limit": intField(defaultValue: 100, maximum: 500),
            "enabled_only": boolField("只看已启用的规则", defaultValue: false),
        ])
    )

    private static let clearDefinition = TraceMCPToolDefinition(
        name: "clear_requests",
        description: "清空抓包记录（危险操作，需 confirm=true）。可选只清某个会话。",
        inputSchema: schema([
            "confirm": boolField("必须为 true 才会执行"),
            "session_id": stringField("只清这个