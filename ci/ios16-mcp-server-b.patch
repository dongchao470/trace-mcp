+    private func accept(_ connection: NWConnection) {
+        let peer = Self.describe(connection.endpoint)
+        lock.lock()
+        let boundToLoopback = state.loopbackInterface
+        state.connectionCount += 1
+        state.lastPeer = peer
+        lock.unlock()
+
+        // A listener bound to the loopback interface cannot receive external traffic,
+        // so the peer check only guards the wildcard fallback.
+        guard boundToLoopback || Self.isLoopback(connection.endpoint)
+            || peer.contains("127.0.0.1") || peer.contains("::1")
+        else {
+            mcpLog.error("mcp.reject peer=\(peer, privacy: .public)")
+            TraceMCPStatusStore.publish(snapshot())
+            connection.cancel()
+            return
+        }
+        TraceMCPStatusStore.publish(snapshot())
+        MCPHTTPConnection(connection: connection, queue: queue).start()
+    }
