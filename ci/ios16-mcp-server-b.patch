+    private static func describe(_ endpoint: NWEndpoint) -> String {
+        switch endpoint {
+        case let .hostPort(host, port):
+            return "\(host):\(port)"
+        case let .service(name, type, domain, _):
+            return "\(name).\(type).\(domain)"
+        case let .unix(path):
+            return path
+        case let .url(url):
+            return url.absoluteString
+        @unknown default:
+            return "unknown"
+        }
+    }
