diff --git a/TraceCore/Models/CaptureHomeScope.swift b/TraceCore/Models/CaptureHomeScope.swift
new file mode 100644
index 0000000..fdb48e8
--- /dev/null
+++ b/TraceCore/Models/CaptureHomeScope.swift
@@ -0,0 +1,28 @@
+import Foundation
+
+/// The single capture run visible on the home screen. History remains in storage.
+public struct CaptureHomeScope: Equatable, Sendable {
+    public let sessionID: UUID
+    public let startTime: Date
+    public let endTime: Date?
+
+    public init(sessionID: UUID, startTime: Date, endTime: Date?) {
+        self.sessionID = sessionID
+        self.startTime = startTime
+        self.endTime = endTime
+    }
+
+    /// Transport records have no session ID, so use the capture's time window.
+    public func contains(timestamp: Date) -> Bool {
+        guard timestamp >= startTime else { return false }
+        if let endTime { return timestamp <= endTime }
+        return true
+    }
+
+    /// An explicit session ID wins; unassigned requests may only enter this run
+    /// when their timestamp falls inside its bounds. Never claim another run.
+    public func contains(timestamp: Date, sessionID: UUID?) -> Bool {
+        if let sessionID { return sessionID == self.sessionID }
+        return contains(timestamp: timestamp)
+    }
+}
diff --git a/TraceLogicTests/TraceCaptureHomeScopeRegressionTests.swift b/TraceLogicTests/TraceCaptureHomeScopeRegressionTests.swift
new file mode 100644
index 0000000..6385ce6
--- /dev/null
+++ b/TraceLogicTests/TraceCaptureHomeScopeRegressionTests.swift
@@ -0,0 +1,62 @@
+import Foundation
+import XCTest
+#if canImport(TraceCriticalFixes)
+@testable import TraceCriticalFixes
+#else
+@testable import TraceCore
+#endif
+
+final class TraceCaptureHomeScopeRegressionTests: XCTestCase {
+    private let currentID = UUID()
+    private let previousID = UUID()
+    private let start = Date(timeIntervalSince1970: 1_000)
+
+    private func scope(ended: Bool = false) -> CaptureHomeScope {
+        CaptureHomeScope(sessionID: currentID, startTime: start,
+                         endTime: ended ? start.addingTimeInterval(60) : nil)
+    }
+
+    func testFirstUnassignedRequestIsVisible() {
+        XCTAssertTrue(scope().contains(timestamp: start.addingTimeInterval(1), sessionID: nil))
+    }
+
+    func testUnassignedHistoryDoesNotEnterNewCapture() {
+        XCTAssertFalse(scope().contains(timestamp: start.addingTimeInterval(-1), sessionID: nil))
+    }
+
+    func testAnotherSessionsRequestNeverEntersCurrentCapture() {
+        XCTAssertFalse(scope().contains(timestamp: start.addingTimeInterval(1), sessionID: previousID))
+    }
+
+    func testExplicitCurrentSessionRemainsVisible() {
+        XCTAssertTrue(scope().contains(timestamp: start.addingTimeInterval(1), sessionID: currentID))
+    }
+
+    func testClosedCaptureDoesNotClaimLaterUnassignedRequests() {
+        XCTAssertFalse(scope(ended: true).contains(timestamp: start.addingTimeInterval(61), sessionID: nil))
+    }
+
+    func testClosedCaptureStillShowsItsUnassignedRequests() {
+        XCTAssertTrue(scope(ended: true).contains(timestamp: start.addingTimeInterval(20), sessionID: nil))
+    }
+
+    func testTransportHistoryIsExcluded() {
+        XCTAssertFalse(scope().contains(timestamp: start.addingTimeInterval(-1)))
+    }
+
+    func testTransportAfterStopIsExcluded() {
+        XCTAssertFalse(scope(ended: true).contains(timestamp: start.addingTimeInterval(61)))
+    }
+
+    func testCaptureBoundariesAreIncluded() {
+        XCTAssertTrue(scope(ended: true).contains(timestamp: start))
+        XCTAssertTrue(scope(ended: true).contains(timestamp: start.addingTimeInterval(60)))
+    }
+
+    func testNewCaptureCannotReplayPreviousCapture() {
+        let next = CaptureHomeScope(sessionID: UUID(), startTime: start.addingTimeInterval(100), endTime: nil)
+        XCTAssertFalse(next.contains(timestamp: start.addingTimeInterval(20), sessionID: nil))
+        XCTAssertFalse(next.contains(timestamp: start.addingTimeInterval(120), sessionID: currentID))
+        XCTAssertTrue(next.contains(timestamp: start.addingTimeInterval(120), sessionID: nil))
+    }
+}
