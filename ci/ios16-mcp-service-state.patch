@@ -0,0 +1,28 @@
+import Foundation
+
+/// Serializes lifecycle decisions and invalidates work scheduled by a previous listener.
+/// A recursive lock permits a guarded retry to call the public, guarded start/stop methods.
+final class TraceMCPListenerLifecycle: @unchecked Sendable {
+    private let lock = NSRecursiveLock()
+    private var epoch: UInt64 = 0
+
+    func withLock<T>(_ operation: () throws -> T) rethrows -> T {
+        lock.lock()
+        defer { lock.unlock() }
+        return try operation()
+    }
+
+    var generation: UInt64 { withLock { epoch } }
+
+    @discardableResult
+    func advance() -> UInt64 { withLock { epoch &+= 1; return epoch } }
+
+    @discardableResult
+    func ifCurrent(_ generation: UInt64, _ operation: () -> Void) -> Bool {
+        withLock {
+            guard epoch == generation else { return false }
+            operation()
+            return true
+        }
+    }
+}
