+import Foundation
+
+/// Actor isolation alone permits re-entry at await points. Chain whole transitions instead.
+public actor RecordingTransitionQueue {
+    private var tail: Task<Void, Never>?
+    private var pendingOperations = 0
+
+    public init() {}
+
+    /// Reads are immediate, but must never acknowledge an in-flight intermediate state.
+    public func readIfIdle<T: Sendable>(_ read: @Sendable () -> T) -> T? {
+        guard pendingOperations == 0 else { return nil }
+        return read()
+    }
+
+    public func perform(_ operation: @escaping @Sendable () async -> Void) async {
+        pendingOperations += 1
+        defer { pendingOperations -= 1 }
+        let predecessor = tail
+        let next = Task {
+            await predecessor?.value
+            await operation()
+        }
+        tail = next
+        await next.value
+    }
+}
