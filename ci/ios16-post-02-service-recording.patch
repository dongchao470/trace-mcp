+import Foundation
+
+/// Process-local recording window. The tunnel updates it before acknowledging a toggle.
+/// Persisting under this lock makes Stop a barrier for queued capture database writes.
+/// Manual requests, replay results and browsing deliberately do not use this gate.
+public final class CaptureRecordingState: @unchecked Sendable {
+    public static let shared = CaptureRecordingState(enabled: false)
+
+    private let lock = NSLock()
+    private var startedAt: Date?
+    private var serviceStopping = false
+
+    public init(enabled: Bool = true, startedAt: Date = .distantPast) {
+        self.startedAt = enabled ? startedAt : nil
+    }
+
+    public var isRecording: Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        return startedAt != nil
+    }
+
+    public func beginService() {
+        lock.lock()
+        serviceStopping = false
+        startedAt = nil
+        lock.unlock()
+    }
+
+    public func endService() {
+        lock.lock()
+        serviceStopping = true
+        startedAt = nil
+        lock.unlock()
+    }
+
+    public func setRecording(_ enabled: Bool, startedAt: Date = Date()) {
+        lock.lock()
+        self.startedAt = enabled && !serviceStopping ? startedAt : nil
+        lock.unlock()
+    }
+
+    /// A response / stream opened before this recording interval cannot leak into the new one.
+    public func allows(startedAt timestamp: Date) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        return startedAt.map { timestamp >= $0 } ?? false
+    }
+
+    @discardableResult
+    public func withRecording<T>(startedAt timestamp: Date, _ action: () throws -> T) rethrows -> T? {
+        lock.lock()
+        defer { lock.unlock() }
+        guard let boundary = startedAt, timestamp >= boundary else { return nil }
+        return try action()
+    }
+}
