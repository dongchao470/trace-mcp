+import Foundation
+import Combine
+
+/// A single-input, owner-scoped cache shared by inline and fullscreen viewers.
+/// View disappearance or mode changes do not cancel shared work; a new input or deinit does.
+@MainActor
+final class BodyJSONModel: ObservableObject {
+    @Published private(set) var generation: UInt64 = 0
+    @Published private(set) var document: BodyJSONDocument?
+    @Published private(set) var rows: [BodyJSONRow] = []
+    @Published private(set) var formattedPages: [String]?
+    @Published private(set) var parseError: String?
+    @Published private(set) var formattingError: String?
+    @Published private(set) var projectionError: String?
+    @Published private(set) var isParsing = false
+    @Published private(set) var isFormatting = false
+    @Published private(set) var isProjecting = false
+
+    private var source: String?
+    private var expansion = BodyJSONExpansion.root
+    private var projectionGeneration: UInt64 = 0
+    private var wantsFormatting = false
+    private var parseTask: Task<BodyJSONPreparedDocument, Error>?
+    private var formattingTask: Task<[String], Error>?
+    private var projectionTask: Task<[BodyJSONRow], Error>?
+    private var parseDelivery: Task<Void, Never>?
+    private var formattingDelivery: Task<Void, Never>?
+    private var projectionDelivery: Task<Void, Never>?
+
+    /// Default values require no actor access, so SwiftUI can own this with @StateObject.
+    nonisolated init() {}
+
+    deinit {
+        parseTask?.cancel()
+        formattingTask?.cancel()
+        projectionTask?.cancel()
+        parseDelivery?.cancel()
+        formattingDelivery?.cancel()
+        projectionDelivery?.cancel()
+    }
+
+    func matches(_ input: String) -> Bool { source == input }
+
+    func clear() {
+        guard source != nil else { return }
+        cancelTasks()
+        generation &+= 1
+        projectionGeneration &+= 1
+        source = nil
+        document = nil
+        rows = []
+        formattedPages = nil
+        parseError = nil
+        formattingError = nil
+        projectionError = nil
+        wantsFormatting = false
+        isParsing = false
+        isFormatting = false
+        isProjecting = false
+    }
+
+    /// Repeated requests for the same String share the existing task/result, even in raw mode.
+    /// This starts work but does not await it, so delivery never retains this owner across an await.
+    func load(_ input: String) {
+        guard source != input else { return }
+        cancelTasks()
+        generation &+= 1
+        projectionGeneration &+= 1
+        let token = generation
+        source = input
+        expansion = .root
+        wantsFormatting = false
+        document = nil
+        rows = []
+        formattedPages = nil
+        parseError = nil
+        formattingError = nil
+        projectionError = nil
+        isParsing = true
+        isFormatting = false
+        isProjecting = false
+
+        let worker = Task.detached(priority: .userInitiated) {
+            let document = try BodyJSONDocument.parse(input)
+            let rows = try document.visibleRows()
+            return BodyJSONPreparedDocument(document: document, rows: rows)
+        }
+        parseTask = worker
+        parseDelivery = Task { [weak self] in
+            let result = await worker.result
+            guard !Task.isCancelled else { return }
+            self?.acceptParse(result, generation: token)
+        }
+    }
+
+    /// Lazy, once-per-document formatting. Leaving formatted mode does not restart/cancel it.
+    func prepareFormattedPages() {
+        wantsFormatting = true
+        guard let document = document, formattedPages == nil,
+              formattingTask == nil, formattingError == nil else { return }
+        isFormatting = true
+        let token = generation
+        let worker = Task.detached(priority: .userInitiated) {
+            try document.formattedPages()
+        }
+        formattingTask = worker
+        formattingDelivery = Task { [weak self] in
+            let result = await worker.result
+            guard !Task.isCancelled else { return }
+            self?.acceptFormatting(result, generation: token)
+        }
+    }
+
+    func toggle(_ nodeID: Int) {
+        guard let document = document, document.nodes.indices.contains(nodeID),
+              document.nodes[nodeID].canExpand else { return }
+        expansion.toggle(nodeID)
+        projectRows()
+    }
+
+    func expandAll() {
+        guard document != nil else { return }
+        expansion = .all
+        projectRows()
+    }
+
+    func collapseAll() {
+        guard document != nil else { return }
+        expansion = .collapsed
+        projectRows()
+    }
+
+    private func acceptParse(_ result: Result<BodyJSONPreparedDocument, Error>, generation token: UInt64) {
+        guard generation == token else { return }
+        parseTask = nil
+        parseDelivery = nil
+        isParsing = false
+        switch result {
+        case .success(let prepared):
+            document = prepared.document
+            rows = prepared.rows
+            if wantsFormatting { prepareFormattedPages() }
+        case .failure(let error):
+            parseError = error.localizedDescription
+        }
+    }
+
+    private func acceptFormatting(_ result: Result<[String], Error>, generation token: UInt64) {
+        guard generation == token else { return }
+        formattingTask = nil
+        formattingDelivery = nil
+        isFormatting = false
+        switch result {
+        case .success(let pages): formattedPages = pages
+        case .failure(let error): formattingError = error.localizedDescription
+        }
+    }
+
+    private func projectRows() {
+        guard let document = document else { return }
+        projectionTask?.cancel()
+        projectionDelivery?.cancel()
+        projectionGeneration &+= 1
+        let projectionToken = projectionGeneration
+        let documentToken = generation
+        let expansion = expansion
+        isProjecting = true
+        projectionError = nil
+        let worker = Task.detached(priority: .userInitiated) {
+            try document.visibleRows(expansion: expansion)
+        }
+        projectionTask = worker
+        projectionDelivery = Task { [weak self] in
+            let result = await worker.result
+            guard !Task.isCancelled else { return }
+            self?.acceptProjection(result, generation: documentToken, projection: projectionToken)
+        }
+    }
+
+    private func acceptProjection(_ result: Result<[BodyJSONRow], Error>,
+                                  generation token: UInt64, projection: UInt64) {
+        guard generation == token, projectionGeneration == projection else { return }
+        projectionTask = nil
+        projectionDelivery = nil
+        isProjecting = false
+        switch result {
+        case .success(let projected): rows = projected
+        case .failure(let error): projectionError = error.localizedDescription
+        }
+    }
+
+    private func cancelTasks() {
+        parseTask?.cancel()
+        formattingTask?.cancel()
+        projectionTask?.cancel()
+        parseDelivery?.cancel()
+        formattingDelivery?.cancel()
+        projectionDelivery?.cancel()
+        parseTask = nil
+        formattingTask = nil
+        projectionTask = nil
+        parseDelivery = nil
+        formattingDelivery = nil
+        projectionDelivery = nil
+    }
+
+}
+
+private struct BodyJSONPreparedDocument: Sendable {
+    let document: BodyJSONDocument
+    let rows: [BodyJSONRow]
+}
