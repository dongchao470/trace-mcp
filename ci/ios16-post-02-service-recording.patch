+import Foundation
+
+/// Hex is generated for a window of source bytes, without a 64KB truncation or a giant string.
+public enum BodyHexPagination {
+    public static let pageBytes = 1024
+    private static let digits = Array("0123456789ABCDEF".utf8)
+
+    public static func pageCount(_ data: Data) -> Int {
+        max(1, data.count / pageBytes + (data.count % pageBytes == 0 ? 0 : 1))
+    }
+
+    public static func page(_ data: Data, index: Int) -> String {
+        guard index >= 0, index < pageCount(data), !Task.isCancelled else { return "" }
+        let offset = index * pageBytes
+        let count = min(pageBytes, data.count - offset)
+        guard count > 0 else { return "" }
+        var output: [UInt8] = []
+        output.reserveCapacity(count * 4)
+        let start = data.index(data.startIndex, offsetBy: offset)
+        for (position, byte) in data[start ..< data.index(start, offsetBy: count)].enumerated() {
+            if position > 0 {
+                if position % 16 == 0 { output.append(10) }
+                else {
+                    output.append(32)
+                    if position % 8 == 0 { output.append(32) }
+                }
+            }
+            output.append(digits[Int(byte >> 4)])
+            output.append(digits[Int(byte & 15)])
+        }
+        return String(decoding: output, as: UTF8.self)
+    }
+}
