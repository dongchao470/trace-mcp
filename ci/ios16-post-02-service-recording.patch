+import Foundation
+import CoreFoundation
+
+/// Stable preorder IDs belong to one immutable document; no `Any` crosses a task boundary.
+struct BodyJSONNode: Identifiable, Sendable {
+    enum Kind: Sendable {
+        case object, array, string, number, boolean, null
+    }
+
+    let id: Int
+    let depth: Int
+    let key: String?
+    let arrayIndex: Int?
+    let kind: Kind
+    /// Decoded strings, or JSON tokens for number/bool/null. Containers have no scalar value.
+    let value: String?
+    let childCount: Int
+    /// Exclusive preorder boundary, allowing collapsed subtrees to be skipped in O(1).
+    let subtreeEndIndex: Int
+    let keyPreview: String?
+    let valuePreview: String
+    let isKeyTruncated: Bool
+    let isValueTruncated: Bool
+
+    var isContainer: Bool {
+        switch kind {
+        case .object, .array: return true
+        default: return false
+        }
+    }
+    var canExpand: Bool { isContainer && childCount > 0 }
+}
+
+struct BodyJSONRow: Identifiable, Sendable {
+    let id: Int
+    let depth: Int
+    let isExpanded: Bool
+}
+
+/// `all` uses exceptions, not a huge set of eagerly expanded IDs.
+struct BodyJSONExpansion: Sendable {
+    private let expandsByDefault: Bool
+    private var exceptions: Set<Int>
+
+    init(expandedIDs: Set<Int>) {
+        expandsByDefault = false
+        exceptions = expandedIDs
+    }
+
+    private init(expandsByDefault: Bool) {
+        self.expandsByDefault = expandsByDefault
+        exceptions = []
+    }
+
