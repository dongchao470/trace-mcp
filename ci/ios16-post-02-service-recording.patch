+import Foundation
+
+/// A bounded hint, not validation. Invalid JSON errors are produced by the background parser.
+enum BodyContentSniffer {
+    enum Hint: Equatable { case json, html, xml, svg }
+    static let prefixBytes = 4096
+
+    static func hint(_ content: String) -> Hint? {
+        let prefix = String(decoding: content.utf8.prefix(prefixBytes), as: UTF8.self)
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        if prefix.hasPrefix("{") || prefix.hasPrefix("[") { return .json }
+        let lower = prefix.lowercased()
+        if lower.contains("<svg") { return .svg }
+        if lower.contains("<!doctype html") || lower.contains("<html") { return .html }
+        if lower.hasPrefix("<?xml") || (lower.hasPrefix("<") && lower.contains("</")) { return .xml }
+        return nil
+    }
+}
