+import Foundation
+
+/// A timed-out provider message may still reply later. Resume its continuation only once.
+final class VPNMessageReply: @unchecked Sendable {
+    enum ReplyError: LocalizedError {
+        case unconfirmed
+        var errorDescription: String? {
+            NSLocalizedString("The network service response timed out; the requested change may already have applied. Check its state before trying again.", comment: "Provider message outcome is unknown")
+        }
+    }
+
+    private let lock = NSLock()
+    private var continuation: CheckedContinuation<Data?, Error>?
+
+    init(_ continuation: CheckedContinuation<Data?, Error>) {
+        self.continuation = continuation
+    }
+
+    func finish(_ result: Result<Data?, Error>) {
+        lock.lock()
+        let pending = continuation
+        continuation = nil
+        lock.unlock()
+        pending?.resume(with: result)
+    }
+}
