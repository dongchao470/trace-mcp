+import Foundation
+import SwiftUI
+
+/// Only one display page is laid out or highlighted, never an entire document.
+struct BodyPageTextView: View {
+    let text: String
+    let syntaxHighlightJSON: Bool
+    @State private var highlighted: AttributedString?
+    @State private var highlightedSource: String?
+
+    var body: some View {
+        Group {
+            if highlightedSource == text, let highlighted {
+                Text(highlighted)
+            } else {
+                Text(text)
+            }
+        }
+        .font(.system(.footnote, design: .monospaced))
+        .textSelection(.enabled)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .fixedSize(horizontal: false, vertical: true)
+        .task(id: text) {
+            highlighted = nil
+            highlightedSource = nil
+            guard syntaxHighlightJSON else { return }
+            let source = text
+            let work = Task.detached(priority: .userInitiated) {
+                Self.highlight(source)
+            }
+            let result = await withTaskCancellationHandler(operation: {
+                await work.value
+            }, onCancel: { work.cancel() })
+            guard !Task.isCancelled else { return }
+            highlighted = result
+            highlightedSource = source
+        }
+    }
+
+    private nonisolated static func highlight(_ source: String) -> AttributedString {
+        var result = AttributedString(source)
+        // The bound is independent of total body size, including cached formatted pages.
+        guard source.utf8.count <= BodyTextPagination.defaultPageBytes + 3,
+              let regex = try? NSRegularExpression(
+                pattern: #"\"(?:\\.|[^\"\\])*\"(\s*:)?|-?\b\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b|\b(?:true|false|null)\b|[\[\]{}]"#)
+        else { return result }
+        let matches = regex.matches(in: source, range: NSRange(source.startIndex..., in: source))
+        for match in matches {
+            if Task.isCancelled { break }
+            guard let swiftRange = Range(match.range, in: source),
+                  let range = Range(match.range, in: result) else { continue }
+            let token = source[swiftRange]
+            let color: Color
+            if token.first == "\"" {
+                color = match.range(at: 1).location == NSNotFound
+                    ? DesignSystem.Colors.success : DesignSystem.Colors.accent
+            } else if token == "null" {
+                color = DesignSystem.Colors.muted
+            } else if token.count == 1, let first = token.first, "[]{}".contains(first) {
+                color = .secondary
+            } else {
+                color = DesignSystem.Colors.warning
+            }
+            result[range].foregroundColor = color
+        }
+        return result
+    }
+}
