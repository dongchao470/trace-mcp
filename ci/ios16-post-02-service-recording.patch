+final class TraceBodyViewerRegressionTests: XCTestCase {
+    private func canonical(_ text: String) throws -> Data {
+        let object = try JSONSerialization.jsonObject(with: Data(text.utf8), options: [.fragmentsAllowed])
+        return try JSONSerialization.data(withJSONObject: object, options: [.fragmentsAllowed, .sortedKeys])
+    }
+
+    func testScalarFragmentsAndEmptyContainersRoundTrip() throws {
+        for text in ["0", "1", "true", "false", "null", "1.25e-12", "\"中文😀\"", "{}", "[]"] {
+            let document = try BodyJSONDocument.parse(text)
+            XCTAssertEqual(try canonical(document.formattedPages().joined()), try canonical(text))
+            XCTAssertFalse(try document.visibleRows().isEmpty)
+        }
+    }
+
+    func testZeroAndOneRemainNumbersNotBooleans() throws {
+        let nodes = try BodyJSONDocument.parse("[0,1,true,false]").nodes
+        XCTAssertEqual(nodes.map(\.value), [nil, "0", "1", "true", "false"])
+        if case .number = nodes[1].kind {} else { XCTFail("0 became Boolean") }
+        if case .number = nodes[2].kind {} else { XCTFail("1 became Boolean") }
+        if case .boolean = nodes[3].kind {} else { XCTFail("true lost its type") }
+    }
+
+    func testEscapingAndUnicodeSurviveSmallPageBoundaries() throws {
+        let value = "中文😀\"\\\n\t\r\u{0000}\u{0008}\u{000C}" + String(repeating: "e\u{0301}", count: 80)
+        let data = try JSONSerialization.data(withJSONObject: ["键😀": value])
+        let source = String(decoding: data, as: UTF8.self)
+        let pages = try BodyJSONDocument.parse(source).formattedPages(pageBytes: 19)
+        XCTAssertGreaterThan(pages.count, 1)
+        XCTAssertTrue(pages.allSatisfy { !$0.isEmpty && $0.utf8.count <= 19 })
+        XCTAssertEqual(try canonical(pages.joined()), try canonical(source))
+    }
+
+    func testLargeJSONNeverFallsBackOrLosesTail() throws {
+        let source = "{\"body\":\"" + String(repeating: "中😀abc", count: 70000) + "TAIL\"}"
