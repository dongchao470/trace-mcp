+import Foundation
+import SwiftUI
+
+struct PagedHexBodyView: View {
+    let content: String
+    let rawData: Data?
+    @State private var bytes: Data?
+
+    private struct Input: Equatable {
+        let content: String
+        let data: Data?
+    }
+
+    var body: some View {
+        Group {
+            if let bytes {
+                HexPageView(data: bytes)
+            } else {
+                ProgressView("正在准备字节视图…")
+            }
+        }
+        .task(id: Input(content: content, data: rawData)) {
+            bytes = nil
+            let source = content
+            let original = rawData
+            let work = Task.detached(priority: .userInitiated) {
+                original ?? Data(source.utf8)
+            }
+            let result = await withTaskCancellationHandler(operation: {
+                await work.value
+            }, onCancel: { work.cancel() })
+            guard !Task.isCancelled else { return }
+            bytes = result
+        }
+    }
+}
+
+private struct HexPageView: View {
+    let data: Data
+    @State private var page = 0
+    @State private var text: String?
+    private var count: Int { BodyHexPagination.pageCount(data) }
+    private struct Request: Equatable { let data: Data; let page: Int }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            if count > 1 {
+                HStack(spacing: 8) {
+                    Button { page = max(0, page - 1) } label: {
+                        Image(systemName: "chevron.left")
+                    }
+                    .disabled(page == 0)
+                    .accessibilityLabel("上一页")
+                    Text("第 \(page + 1) / \(count) 页")
+                        .font(.caption).monospacedDigit().foregroundStyle(.secondary)
+                    Button { page = min(count - 1, page + 1) } label: {
+                        Image(systemName: "chevron.right")
+                    }
+                    .disabled(page + 1 >= count)
+                    .accessibilityLabel("下一页")
+                    Spacer(minLength: 0)
+                }
+                .buttonStyle(.bordered)
+                .controlSize(.small)
+            }
+            if let text {
+                BodyPageTextView(text: text, syntaxHighlightJSON: false)
+            } else {
+                ProgressView("正在读取当前页…")
+            }
+        }
+        .onChangeCompat(of: data) { _ in page = 0 }
+        .task(id: Request(data: data, page: page)) {
+            text = nil
+            let input = data
+            let index = min(page, count - 1)
+            let work = Task.detached(priority: .userInitiated) {
+                BodyHexPagination.page(input, index: index)
+            }
+            let result = await withTaskCancellationHandler(operation: {
+                await work.value
+            }, onCancel: { work.cancel() })
+            guard !Task.isCancelled else { return }
+            text = result
+        }
+    }
+}
