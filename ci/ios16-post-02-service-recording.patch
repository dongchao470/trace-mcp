+import Combine
+import Foundation
+import NetworkExtension
+import TraceCore
+import TraceFeatures
+
+/// Owns only the app listener. Never starts a VPN or changes the recording preference.
+@MainActor
+final class AppMCPServiceCoordinator: ObservableObject {
+    static let shared = AppMCPServiceCoordinator()
+    @Published private(set) var isForeground = false
+    @Published private(set) var isChecking = false
+    @Published private(set) var lastError: String?
+    private var observer: AnyCancellable?
+    private var reconciliation: Task<Void, Never>?
+    private var generation = 0
+
+    private init() {
+        observer = NotificationCenter.default.publisher(for: .NEVPNStatusDidChange)
+            .receive(on: DispatchQueue.main)
+            .sink { [weak self] _ in self?.refresh() }
+    }
+
+    func setForeground(_ foreground: Bool) {
+        isForeground = foreground
+        refresh()
+    }
+
+    func refresh(notifyExtension: Bool = false) {
+        generation += 1
+        let request = generation
+        reconciliation?.cancel()
+        lastError = nil
+        guard isForeground else {
+            isChecking = false
+            TraceMCPServer.shared.stop()
+            return
+        }
+        let preferences = TraceMCPPreferences.load()
+        if !preferences.enabled { TraceMCPServer.shared.stop() }
+        // Unknown/connecting/reasserting must not be mistaken for a stopped extension.
+        if !VPNManager.shared.isDefinitelyStopped { TraceMCPServer.shared.stop() }
+        isChecking = true
+        reconciliation = Task { [weak self] in
+            guard let self else { return }
+            do {
+                try await VPNManager.shared.prepareForControl()
+                guard !Task.isCancelled, request == self.generation, self.isForeground else { return }
+                if VPNManager.shared.isConnected, notifyExtension {
+                    let data = try await VPNManager.shared.sendMessage(["command": "refreshMCP"])
+                    guard !Task.isCancelled, request == self.generation else { return }
+                    guard let data,
+                          let reply = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+                          reply["enabled"] as? Bool == preferences.enabled,
+                          reply["port"] as? Int == Int(preferences.port) else {
+                        throw NSError(domain: "TraceMCP", code: 1, userInfo: [NSLocalizedDescriptionKey:
+                            "MCP 设置已保存，但尚未确认扩展应用；请核对状态，不要重复启停网络服务。"])
+                    }
+                }
+                self.isChecking = false
+                if VPNManager.shared.isDefinitelyStopped, preferences.enabled {
+                    TraceMCPBootstrap.startRetryingIfEnabled(host: "app")
+                } else {
+                    TraceMCPServer.shared.stop()
+                }
+            } catch {
+                guard !Task.isCancelled, request == self.generation else { return }
+                self.isChecking = false
+                self.lastError = error.localizedDescription
+                TraceMCPServer.shared.stop()
+            }
+        }
+    }
+}
