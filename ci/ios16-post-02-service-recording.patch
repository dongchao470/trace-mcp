+struct BodyJSONDocument: Sendable {
+    static let maximumPageBytes = 8 * 1024
+    let nodes: [BodyJSONNode]
+    let sourceByteCount: Int
+    var rootID: Int { 0 }
+
+    /// Exactly one JSONSerialization parse, including top-level scalar fragments.
+    static func parse(_ source: String) throws -> Self {
+        try Task<Never, Never>.checkCancellation()
+        let data = Data(source.utf8)
+        try Task<Never, Never>.checkCancellation()
+        let object = try JSONSerialization.jsonObject(with: data, options: [.fragmentsAllowed])
+        // Foundation's synchronous parser cannot be interrupted, so check again before traversal.
+        try Task<Never, Never>.checkCancellation()
+        var builder = BodyJSONDocumentBuilder()
+        try builder.append(object, key: nil, arrayIndex: nil, depth: 0)
+        try Task<Never, Never>.checkCancellation()
+        return Self(nodes: builder.nodes, sourceByteCount: data.count)
+    }
+
+    func visibleRows(expandedIDs: Set<Int>) throws -> [BodyJSONRow] {
+        try visibleRows(expansion: BodyJSONExpansion(expandedIDs: expandedIDs))
+    }
+
+    /// Work is proportional to visible rows; no recursive view hierarchy or child-count cap.
+    func visibleRows(expansion: BodyJSONExpansion = .root) throws -> [BodyJSONRow] {
+        try Task<Never, Never>.checkCancellation()
+        var result: [BodyJSONRow] = []
+        var index = 0
+        while index < nodes.count {
+            if result.count & 127 == 0 { try Task<Never, Never>.checkCancellation() }
+            let node = nodes[index]
+            let expanded = node.canExpand && expansion.contains(node.id)
+            result.append(BodyJSONRow(id: node.id, depth: node.depth, isExpanded: expanded))
+            if expanded { index += 1 }
+            else { index = node.subtreeEndIndex }
+        }
+        try Task<Never, Never>.checkCancellation()
+        return result
+    }
+
+    /// Formats the parsed nodes directly, never reparsing or constructing one giant pretty string.
+    /// Joining the pages yields valid pretty JSON; each page is at most 8192 UTF-8 bytes.
+    func formattedPages(pageBytes: Int = maximumPageBytes) throws -> [String] {
+        try Task<Never, Never>.checkCancellation()
+        var writer = BodyJSONPageWriter(pageBytes: pageBytes)
+        if !nodes.isEmpty { try writeNode(0, to: &writer) }
+        try Task<Never, Never>.checkCancellation()
+        return writer.finish()
+    }
+
+    private func writeNode(_ index: Int, to writer: inout BodyJSONPageWriter) throws {
+        try Task<Never, Never>.checkCancellation()
+        let node = nodes[index]
+        if let key = node.key {
+            try writer.appendQuoted(key)
+            try writer.append(": ")
+        }
+        switch node.kind {
+        case .object, .array:
+            let isObject: Bool
+            switch node.kind {
+            case .object: isObject = true
+            default: isObject = false
+            }
+            try writer.append(isObject ? "{" : "[")
+            if node.childCount > 0 {
+                try writer.append("\n")
+                var child = index + 1
+                while child < node.subtreeEndIndex {
+                    try writer.indent(nodes[child].depth)
+                    try writeNode(child, to: &writer)
+                    child = nodes[child].subtreeEndIndex
+                    if child < node.subtreeEndIndex { try writer.append(",") }
+                    try writer.append("\n")
+                }
+                try writer.indent(node.depth)
+            }
+            try writer.append(isObject ? "}" : "]")
+        case .string:
+            guard let value = node.value else { throw BodyJSONDocumentError.unsupportedValue }
+            try writer.appendQuoted(value)
+        case .number, .boolean, .null:
+            guard let value = node.value else { throw BodyJSONDocumentError.unsupportedValue }
+            try writer.append(value)
+        }
+    }
+}
+
+private enum BodyJSONDocumentError: LocalizedError {
+    case unsupportedValue
+    var errorDescription: String? { "JSON 中包含无法显示的值。" }
+}
+
+private struct BodyJSONDocumentBuilder {
+    var nodes: [BodyJSONNode] = []
+
+    mutating func append(_ object: Any, key: String?, arrayIndex: Int?, depth: Int) throws {
+        try Task<Never, Never>.checkCancellation()
+        let id = nodes.count
+        let keySummary = key.map { BodyJSONPreview.quoted($0) }
+        let kind: BodyJSONNode.Kind
+        let value: String?
+        let childCount: Int
+        let dictionary = object as? [String: Any]
+        let array = object as? [Any]
+        if let dictionary = dictionary {
+            kind = .object
+            value = nil
+            childCount = dictionary.count
+        } else if let array = array {
+            kind = .array
+            value = nil
+            childCount = array.count
+        } else if let number = object as? NSNumber {
+            // Swift's `as? Bool` also accepts NSNumber(0/1); test CF identity instead.
+            if CFGetTypeID(number) == CFBooleanGetTypeID() {
+                kind = .boolean
+                value = number.boolValue ? "true" : "false"
+            } else {
+                kind = .number
+                value = number.stringValue
+            }
+            childCount = 0
+        } else if let string = object as? String {
+            kind = .string
+            value = string
+            childCount = 0
+        } else if object is NSNull {
+            kind = .null
+            value = "null"
+            childCount = 0
+        } else {
+            throw BodyJSONDocumentError.unsupportedValue
+        }
+
+        let summary: (text: String, truncated: Bool)
+        switch kind {
+        case .object: summary = ("{ \(childCount) 个成员 }", false)
+        case .array: summary = ("[ \(childCount) 项 ]", false)
+        case .string:
+            guard let value = value else { throw BodyJSONDocumentError.unsupportedValue }
+            summary = BodyJSONPreview.quoted(value)
+        case .number, .boolean, .null:
+            guard let value = value else { throw BodyJSONDocumentError.unsupportedValue }
+            summary = (value, false)
+        }
+        func node(endingAt end: Int) -> BodyJSONNode {
+            BodyJSONNode(id: id, depth: depth, key: key, arrayIndex: arrayIndex,
+                         kind: kind, value: value, childCount: childCount, subtreeEndIndex: end,
+                         keyPreview: keySummary?.text, valuePreview: summary.text,
+                         isKeyTruncated: keySummary?.truncated ?? false,
+                         isValueTruncated: summary.truncated)
+        }
+        nodes.append(node(endingAt: id + 1))
+        if let dictionary = dictionary {
+            // Sorting makes IDs and formatted output deterministic for the same input value.
+            let keys = dictionary.keys.sorted()
+            try Task<Never, Never>.checkCancellation()
+            for childKey in keys {
+                try Task<Never, Never>.checkCancellation()
+                guard let child = dictionary[childKey] else {
+                    throw BodyJSONDocumentError.unsupportedValue
+                }
+                try append(child, key: childKey, arrayIndex: nil, depth: depth + 1)
+            }
+        } else if let array = array {
+            for (offset, child) in array.enumerated() {
+                try append(child, key: nil, arrayIndex: offset, depth: depth + 1)
+            }
+        }
+        nodes[id] = node(endingAt: nodes.count)
+    }
+}
+
+private enum BodyJSONPreview {
+    /// Scalar-based: even one enormous combining-character cluster stays a bounded preview.
+    static func quoted(_ value: String) -> (text: String, truncated: Bool) {
+        var text = "\""
+        var count = 0
+        var truncated = false
+        for scalar in value.unicodeScalars {
+            if count == 120 { truncated = true; break }
+            text += BodyJSONEscaping.token(for: scalar)
+            count += 1
+        }
+        if truncated { text += "…" }
+        text += "\""
+        return (text, truncated)
+    }
+}
+
+private enum BodyJSONEscaping {
+    static func token(for scalar: Unicode.Scalar) -> String {
+        switch scalar.value {
+        case 0x22: return "\\\""
+        case 0x5C: return "\\\\"
+        case 0x08: return "\\b"
+        case 0x0C: return "\\f"
+        case 0x0A: return "\\n"
+        case 0x0D: return "\\r"
+        case 0x09: return "\\t"
+        case 0...0x1F: return String(format: "\\u%04X", scalar.value)
+        default: return String(scalar)
+        }
+    }
+}
+
+private struct BodyJSONPageWriter {
+    private let limit: Int
+    private var pages: [String] = []
+    private var buffer = ""
+    private var bufferBytes = 0
+    private var work = 0
+
+    init(pageBytes: Int) {
+        limit = min(BodyJSONDocument.maximumPageBytes, max(4, pageBytes))
+    }
+
+    mutating func append(_ text: String) throws {
+        for scalar in text.unicodeScalars {
+            work &+= 1
+            if work & 1023 == 0 { try Task<Never, Never>.checkCancellation() }
+            let value = scalar.value
+            let bytes: Int
+            if value <= 0x7F { bytes = 1 }
+            else if value <= 0x7FF { bytes = 2 }
+            else if value <= 0xFFFF { bytes = 3 }
+            else { bytes = 4 }
+            if bufferBytes + bytes > limit {
+                pages.append(buffer)
+                buffer = ""
+                bufferBytes = 0
+            }
+            buffer.unicodeScalars.append(scalar)
+            bufferBytes += bytes
+        }
+    }
+
+    mutating func appendQuoted(_ value: String) throws {
+        try append("\"")
+        for scalar in value.unicodeScalars {
+            try append(BodyJSONEscaping.token(for: scalar))
+        }
+        try append("\"")
+    }
+
+    mutating func indent(_ depth: Int) throws {
+        for _ in 0..<(depth * 2) { try append(" ") }
+    }
+
+    mutating func finish() -> [String] {
+        if !buffer.isEmpty || pages.isEmpty { pages.append(buffer) }
+        return pages
+    }
+}
