+    // MARK: - Bulk actions
+
+    /// Deletes every session with its requests and its folder.
+    ///
+    /// Requests are removed per session so their body files are cleaned up as
+    /// well; `deleteAllSessionsAndFiles` afterwards catches rows and folders
+    /// that no longer had a request attached.
+    func clearAllSessions() async throws {
+        let storage = self.storage
+        let snapshots = rows.map(\.session)
+        try await Task.detached(priority: .userInitiated) {
+            for session in snapshots {
+                try CaptureSessionStore.deleteSessionAndFiles(storage: storage, session: session)
+            }
+            try storage.deleteAllSessionsAndFiles()
+        }.value
+        await reload(showSpinner: false)
+    }
+
+    /// Exports every stored request as one HAR file.
+    func exportAllRequestsHAR() async throws -> URL {
+        let storage = self.storage
+        let requests = try await Task.detached(priority: .userInitiated) {
+            try await storage.loadRequests()
+        }.value
+        return try HARExporter.exportToFile(requests: requests)
+    }
 }
 
