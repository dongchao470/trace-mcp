+// MARK: - Runtime diagnostics
+
+/// Snapshot of the MCP endpoint, mirrored to `mcp-status.json` in the shared container.
+public struct TraceMCPRuntimeSnapshot: Codable, Sendable {
+    public let host: String
+    public let port: UInt16
+    public let listening: Bool
+    public let loopbackInterface: Bool
+    public let lastError: String?
+    public let lastPeer: String?
+    public let connections: Int
+    public let selfCheck: String?
+    public let selfCheckStatus: Int?
+    public let updatedAt: String
+    public let pid: Int32
+
+    public init(
+        host: String,
+        port: UInt16,
+        listening: Bool,
+        loopbackInterface: Bool,
+        lastError: String?,
+        lastPeer: String?,
+        connections: Int,
+        selfCheck: String?,
+        selfCheckStatus: Int?,
+        updatedAt: String,
+        pid: Int32
+    ) {
+        self.host = host
+        self.port = port
+        self.listening = listening
+        self.loopbackInterface = loopbackInterface
+        self.lastError = lastError
+        self.lastPeer = lastPeer
+        self.connections = connections
+        self.selfCheck = selfCheck
+        self.selfCheckStatus = selfCheckStatus
+        self.updatedAt = updatedAt
+        self.pid = pid
+    }
+}
+
+public enum TraceMCPStatusStore {
+    public static let fileName = "mcp-status.json"
+
+    public static var fileURL: URL? {
+        AppGroupStorage.shared.containerURL?.appendingPathComponent(fileName)
+    }
+
+    public static func publish(_ snapshot: TraceMCPRuntimeSnapshot) {
+        guard let url = fileURL else { return }
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        guard let data = try? encoder.encode(snapshot) else { return }
+        try? data.write(to: url, options: .atomic)
+    }
+
+    public static func loadLastSnapshot() -> TraceMCPRuntimeSnapshot? {
+        guard let url = fileURL, let data = try? Data(contentsOf: url) else { return nil }
+        return try? JSONDecoder().decode(TraceMCPRuntimeSnapshot.self, from: data)
     }
 }
