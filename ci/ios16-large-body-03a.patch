diff --git a/TraceProxy/MITM/NIOMITMRequestBodyPolicy.swift b/TraceProxy/MITM/NIOMITMRequestBodyPolicy.swift
new file mode 100644
--- /dev/null
+++ b/TraceProxy/MITM/NIOMITMRequestBodyPolicy.swift
@@ -0,0 +1,17 @@
+import Foundation
+
+/// Capture storage is a bounded preview, never a source for an unchanged wire request.
+enum NIOMITMRequestBodyPolicy {
+    static func select(
+        originalBody: Data,
+        bodyWasModified: Bool,
+        bodyIsEmpty: Bool,
+        readModifiedBody: () -> Data?
+    ) -> Data? {
+        guard bodyWasModified else { return originalBody }
+        // An explicitly cleared body must not fall back to the original upload.
+        guard !bodyIsEmpty else { return Data() }
+        // A missing modified-body file is an error, not permission to replay a preview.
+        return readModifiedBody()
+    }
+}
