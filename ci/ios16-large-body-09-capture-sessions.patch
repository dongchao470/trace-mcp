+//
+//  SessionListView.swift
+//  Trace
+//
+//  First-level list of capture session records. Each row is one capture
+//  session; tapping it opens the requests that belong to that session.
+//
+
+import Combine
+import SwiftUI
+import TraceCore
+import TraceUI
+
+struct SessionListView: View {
+    @StateObject private var viewModel = SessionListViewModel()
+    @Environment(\.scenePhase) private var scenePhase
+
+    @State private var pendingDeletion: CaptureSessionRowModel?
+    @State private var infoAlert: SessionInfoAlert?
+
+    /// Keeps the row of a running session (request count, duration) fresh.
+    private let autoRefreshTimer = Timer.publish(every: 5, on: .main, in: .common).autoconnect()
+
+    var body: some View {
+        sessionList
+            .navigationTitle("Capture Sessions")
+            .navigationBarTitleDisplayMode(.large)
+            .task {
+                await viewModel.loadIfNeeded()
+            }
+            .onChangeCompat(of: scenePhase) { phase in
+                guard phase == .active else { return }
+                Task { await viewModel.reload(showSpinner: false) }
+            }
+            .onReceive(autoRefreshTimer) { _ in
+                guard viewModel.hasActiveSession else { return }
+                Task { await viewModel.reload(showSpinner: false) }
+            }
+            .confirmationDialog(
+                "Delete Capture Session?",
+                isPresented: Binding(
+                    get: { pendingDeletion != nil },
+                    set: { isPresented in
+                        if !isPresented { pendingDeletion = nil }
+                    }
+                ),
+                titleVisibility: .visible,
+                presenting: pendingDeletion
+            ) { row in
+                Button("Delete Session", role: .destructive) {
+                    let target = row
+                    pendingDeletion = nil
+                    Task { await delete(target) }
+                }
+                Button("Cancel", role: .cancel) {
+                    pendingDeletion = nil
+                }
+            } message: { row in
+                Text("This deletes \(row.requestCount) requests, the session record and its pcap file. This cannot be undone.")
+            }
+            .alert(
+                infoAlert?.title ?? "",
+                isPresented: Binding(
+                    get: { infoAlert != nil },
+                    set: { isPresented in
+                        if !isPresented { infoAlert = nil }
+                    }
+                ),
+                presenting: infoAlert
+            ) { _ in
+                Button("OK", role: .cancel) {
+                    infoAlert = nil
+                }
+            } message: { alert in
+                Text(alert.message)
+            }
+    }
+
+    // MARK: - List
+
+    private var sessionList: some View {
+        List {
+            if let message = viewModel.loadState.errorMessage, !viewModel.rows.isEmpty {
+                Section {
+                    errorBanner(message)
+                }
+            }
+
+            Section {
+                ForEach(viewModel.rows) { row in
+                    NavigationLink {
+                        SessionDetailView(session: row.session)
+                    } label: {
+                        SessionRowView(row: row)
+                    }
+                    .swipeActions(edge: .trailing, allowsFullSwipe: false) {
+                        Button(role: .destructive) {
+                            requestDeletion(of: row)
+                        } label: {
+                            Label("Delete", systemImage: "trash")
+                        }
+                    }
+                    .contextMenu {
+                        Button(role: .destructive) {
+                            requestDeletion(of: row)
+                        } label: {
+                            Label("Delete Session", systemImage: "trash")
+                        }
+                    }
+                }
+            } footer: {
+                if !viewModel.rows.isEmpty {
+                    Text("Swipe a session to delete its requests, its record and its pcap file.")
+                }
+            }
+        }
+        .listStyle(.insetGrouped)
+        .refreshable {
+            await viewModel.reload(showSpinner: false)
+        }
+        .overlay {
+            if viewModel.rows.isEmpty {
+                emptyState
+            }
+        }
+    }
+
+    private func errorBanner(_ message: String) -> some View {
+        HStack(alignment: .top, spacing: DesignSystem.Spacing.sm) {
+            Image(systemName: "exclamationmark.triangle.fill")
+                .foregroundStyle(DesignSystem.Colors.warning)
+            VStack(alignment: .leading, spacing: DesignSystem.Spacing.xxs) {
+                Text("Couldn't refresh sessions")
+                    .font(.footnote.weight(.semibold))
+                Text(message)
+                    .font(.caption)
+                    .foregroundStyle(.secondary)
+            }
+        }
+        .accessibilityElement(children: .combine)
+    }
+
+    // MARK: - Empty / loading / error
+
+    @ViewBuilder
+    private var emptyState: some View {
+        switch viewModel.loadState {
+        case .idle, .loading:
+            VStack(spacing: DesignSystem.Spacing.md) {
+                ProgressView()
+                Text("Loading Sessions…")
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+            }
+            .padding()
+            .accessibilityElement(children: .combine)
+            .accessibilityLabel("Loading sessions")
+
+        case let .failed(message):
+            TraceContentUnavailableView(
+                "Couldn't Load Sessions",
+                systemImage: "exclamationmark.triangle",
+                description: Text(message),
+                actionTitle: "Try Again",
+                action: {
+                    Task { await viewModel.reload(showSpinner: true) }
+                }
+            )
+            .padding()
+
+        case .loaded:
+            TraceContentUnavailableView(
+                "No Capture Sessions",
+                systemImage: "record.circle",
+                description: Text("Every capture session lands here with its requests, traffic and pcap file. Start capturing from the Network tab to record one.")
+            )
+            .padding()
+        }
+    }
+
+    // MARK: - Deletion
+
+    private func requestDeletion(of row: CaptureSessionRowModel) {
+        guard !row.session.isActive else {
+            infoAlert = SessionInfoAlert(
+                title: String(localized: "Session Still Recording"),
+                message: String(localized: "Stop capturing before deleting this session.")
+            )
+            return
+        }
+        DesignSystem.Haptics.light()
+        pendingDeletion = row
+    }
+
+    private func delete(_ row: CaptureSessionRowModel) async {
+        if let message = await viewModel.delete(row) {
+            DesignSystem.Haptics.error()
+            infoAlert = SessionInfoAlert(
+                title: String(localized: "Delete Failed"),
+                message: message
+            )
+        } else {
+            DesignSystem.Haptics.success()
+        }
+    }
+}
+
+// MARK: - Alert payload
+
+struct SessionInfoAlert: Identifiable {
+    let id = UUID()
+    let title: String
+    let message: String
+}
+
+// MARK: - Previews
+
+#Preview("Sessions Empty") {
+    NavigationStack {
+        SessionListView()
+    }
+}
