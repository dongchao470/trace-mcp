diff --git a/Trace/Views/Sessions/SessionDetailView.swift b/Trace/Views/Sessions/SessionDetailView.swift
new file mode 100644
index 0000000..00120cc
--- /dev/null
+++ b/Trace/Views/Sessions/SessionDetailView.swift
@@ -0,0 +1,206 @@
+//
+//  SessionDetailView.swift
+//  Trace
+//
+//  One capture session: header with timing, traffic and pcap details, followed
+//  by the requests that were recorded during that session.
+//
+
+import Combine
+import SwiftUI
+import TraceCore
+import TraceFeatures
+import TraceUI
+
+struct SessionDetailView: View {
+    @StateObject private var viewModel: SessionDetailViewModel
+    @ObservedObject private var favorites = FavoritesManager.shared
+    @Environment(\.scenePhase) private var scenePhase
+
+    /// Keeps an in-progress session's duration and requests up to date.
+    private let autoRefreshTimer = Timer.publish(every: 5, on: .main, in: .common).autoconnect()
+
+    init(session: CaptureSession) {
+        _viewModel = StateObject(wrappedValue: SessionDetailViewModel(session: session))
+    }
+
+    var body: some View {
+        List {
+            headerSection
+            statisticsSection
+            requestsSection
+        }
+        .listStyle(.insetGrouped)
+        .navigationTitle(viewModel.displayTitle)
+        .navigationBarTitleDisplayMode(.inline)
+        .task {
+            await viewModel.loadIfNeeded()
+        }
+        .refreshable {
+            await viewModel.reload(showSpinner: false)
+        }
+        .onChangeCompat(of: scenePhase) { phase in
+            guard phase == .active else { return }
+            Task { await viewModel.reload(showSpinner: false) }
+        }
+        .onReceive(autoRefreshTimer) { _ in
+            guard viewModel.status == .active else { return }
+            Task { await viewModel.reload(showSpinner: false) }
+        }
+    }
+
+    // MARK: - Header
+
+    private var headerSection: some View {
+        Section {
+            HStack(spacing: DesignSystem.Spacing.sm) {
+                SessionStatusBadge(status: viewModel.status)
+                Spacer(minLength: DesignSystem.Spacing.xs)
+                Text(CaptureSessionFormat.relativeDate(viewModel.session.startTime))
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+            }
+            .accessibilityElement(children: .combine)
+
+            LabeledContent("Started", value: CaptureSessionFormat.absoluteDate(viewModel.session.startTime))
+
+            if let endTime = viewModel.session.endTime {
+                LabeledContent("Ended", value: CaptureSessionFormat.absoluteDate(endTime))
+            } else {
+                LabeledContent("Ended") {
+                    Text("Recording")
+                        .foregroundStyle(DesignSystem.Colors.danger)
+                }
+            }
+
+            LabeledContent("Duration") {
+                durationValue
+            }
+
+            if let endReason = viewModel.endReasonText {
+                LabeledContent("End Reason", value: endReason)
+            }
+        } footer: {
+            Text("Session \(viewModel.shortIdentifier)")
+        }
+    }
+
+    /// Recording sessions tick once a second; finished ones are static.
+    @ViewBuilder
+    private var durationValue: some View {
+        if viewModel.status == .active {
+            TimelineView(.periodic(from: .now, by: 1)) { context in
+                Text(verbatim: CaptureSessionFormat.duration(viewModel.session.duration(relativeTo: context.date)))
+            }
+        } else {
+            Text(verbatim: CaptureSessionFormat.duration(viewModel.session.duration))
+        }
+    }
+
+    // MARK: - Statistics
+
+    private var statisticsSection: some View {
+        Section("Statistics") {
+            LabeledContent("Requests", value: "\(requestCount)")
+
+            LabeledContent("Traffic", value: CaptureSessionFormat.bytes(trafficBytes))
+
+            LabeledContent("PCAP File") {
+                Text(verbatim: CaptureSessionFormat.bytes(viewModel.pcapBytes) + " · " + viewModel.pcapFileName)
+                    .lineLimit(1)
+                    .minimumScaleFactor(0.8)
+            }
+        }
+    }
+
+    private var requestCount: Int {
+        viewModel.requests.isEmpty ? viewModel.session.requestCount : viewModel.requests.count
+    }
+
+    private var trafficBytes: Int64 {
+        guard !viewModel.requests.isEmpty else {
+            return viewModel.session.totalDataTransferred
+        }
+        return viewModel.requests.reduce(Int64(0)) { partial, request in
+            partial + Int64(request.responseSize ?? request.requestSize ?? 0)
+        }
+    }
+
+    // MARK: - Requests
+
+    private var requestsSection: some View {
+        Section {
+            requestsContent
+        } header: {
+            HStack {
+                Text("Requests")
+                Spacer()
+                Text("\(requestCount)")
+                    .foregroundStyle(.secondary)
+            }
+        }
+    }
+
+    @ViewBuilder
+    private var requestsContent: some View {
+        if viewModel.loadState == .loading, viewModel.requests.isEmpty {
+            HStack {
+                Spacer()
+                ProgressView()
+                Spacer()
+            }
+            .listRowBackground(Color.clear)
+            .accessibilityLabel("Loading requests")
+
+        } else if let message = viewModel.loadState.errorMessage, viewModel.requests.isEmpty {
+            TraceContentUnavailableView(
+                "Couldn't Load Requests",
+                systemImage: "exclamationmark.triangle",
+                description: Text(message),
+                actionTitle: "Try Again",
+                action: {
+                    Task { await viewModel.reload(showSpinner: true) }
+                }
+            )
+            .frame(maxWidth: .infinity)
+            .listRowBackground(Color.clear)
+
+        } else if viewModel.requests.isEmpty {
+            TraceContentUnavailableView(
+                "No Requests",
+                systemImage: "list.bullet",
+                description: Text("This session recorded no requests.")
+            )
+            .frame(maxWidth: .infinity)
+            .listRowBackground(Color.clear)
+
+        } else {
+            ForEach(viewModel.requests) { request in
+                NavigationLink {
+                    DetailView(request: request)
+                } label: {
+                    RequestListRow(
+                        request: request,
+                        isFavorited: favorites.isFavorited(requestId: request.id)
+                    )
+                }
+            }
+        }
+    }
+}
