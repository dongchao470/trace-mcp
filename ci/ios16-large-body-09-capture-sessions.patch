diff --git a/TraceVPN/Providers/CaptureSessionCoordinator.swift b/TraceVPN/Providers/CaptureSessionCoordinator.swift
new file mode 100644
index 0000000..c3e6e01
--- /dev/null
+++ b/TraceVPN/Providers/CaptureSessionCoordinator.swift
@@ -0,0 +1,272 @@
+//
+//  CaptureSessionCoordinator.swift
+//  TraceVPN
+//
+//  Created by Justin on 2026/03/18.
+//
+
+import Foundation
+import OSLog
+import TraceCore
+import TraceProxy
+
+/// Owns the capture-session identity inside the VPN extension.
+///
+/// Discussion: A capture session belongs to one run of the tunnel. The app creates the session in
+/// `CaptureViewModel.startNewSession()` immediately before it asks `VPNManager` to start the tunnel,
+/// and this coordinator adopts that row so every PCAP file lands in
+/// `SessionDirectory.directory(for:createdAt:)`. The extension also covers the runs the app never
+/// sees (widget / Quick Action / system start): when no open session exists it creates one.
+///
+/// Ownership rules:
+/// - One coordinator per `PacketTunnelProvider`, so one session per tunnel run.
+/// - PCAP files are opened per session directory. A writer that already wrote to a file of the
+///   current session may continue it; a new session always starts from an empty file.
+/// - Finalising is idempotent: if the app already wrote `endTime` / `endReason`, the extension only
+///   refreshes the statistics.
+final class CaptureSessionCoordinator: @unchecked Sendable {
+    /// Identifies the session whose directory receives this run's PCAP files.
+    struct SessionRef: Equatable, Sendable {
+        let id: UUID
+        let createdAt: Date
+    }
+
+    /// The session's primary PCAP (HTTP-level capture), matching `CaptureSession.pcapFileName`.
+    static let primaryPCAPFileName = CaptureSession.defaultPCAPFileName
+    /// Raw packet capture used when the tunnel routes packets itself.
+    static let packetPCAPFileName = "packets.pcap"
+
+    private let lock = NSLock()
+    private var session: SessionRef?
+    private var writers: [String: PCAPWriting] = [:]
+    private let storage: AppGroupStorage
+
+    init(storage: AppGroupStorage = .shared) {
+        self.storage = storage
+    }
+
+    /// The session this tunnel run writes to, if `begin()` already resolved one.
+    var currentSession: SessionRef? {
+        lock.lock()
+        defer { lock.unlock() }
+        return session
+    }
+
+    // MARK: - Lifecycle
+
+    /// Resolves the session for this tunnel run: adopts the session the app just created, or creates one.
+    /// - Parameter date: Reference time, injectable for tests.
+    /// - Returns: The session reference, or `nil` when the session directory could not be prepared.
+    @discardableResult
+    func begin(at date: Date = Date()) -> SessionRef? {
+        lock.lock()
+        if let existing = session {
+            lock.unlock()
+            return existing
+        }
+        lock.unlock()
+
+        let resolved: SessionRef?
+        if let adopted = adoptPendingSession() {
+            resolved = adopted
+            VPNLog.tunnel.info(
+                "event=vpn.capture_session outcome=adopted session_id=\(adopted.id.uuidString, privacy: .public)"
+            )
+        } else {
+            resolved = createSession(now: date)
+        }
+
+        guard let resolved else { return nil }
+        lock.lock()
+        session = resolved
+        lock.unlock()
+        return resolved
+    }
+
+    /// The PCAP writer for `fileName` inside the current session, opened on first use and reused afterwards.
+    /// - Parameter fileName: File name relative to the session directory.
+    /// - Returns: `nil` when no session is active or the file cannot be opened.
+    func writer(fileName: String) -> PCAPWriting? {
+        guard let ref = currentSession else {
+            VPNLog.tunnel.error("event=vpn.pcap_writer_start outcome=skipped reason=no_capture_session")
+            return nil
+        }
+        let key = "\(ref.id.uuidString)/\(fileName)"
+
+        lock.lock()
+        defer { lock.unlock() }
+        if let existing = writers[key] {
+            guard existing.isClosed else { return existing }
+            writers[key] = nil
+        }
+
+        let url: URL
+        if fileName == Self.primaryPCAPFileName {
+            url = SessionDirectory.pcapURL(for: ref.id, createdAt: ref.createdAt)
+        } else {
+            url = SessionDirectory.url(for: ref.id, createdAt: ref.createdAt, fileName: fileName)
+        }
+        // A file that already holds this session's records is continued; anything else starts empty.
+        let fileSize = (try? FileManager.default.attributesOfItem(atPath: url.path)[.size] as? NSNumber)?
+            .uint64Value ?? 0
+        let mode: PCAPFileMode = fileSize > 0 ? .continueSession : .newSession
+        do {
+            let writer = try PCAPWriter(fileURL: url, mode: mode)
+            writers[key] = writer
+            VPNLog.tunnel.info(
+                "event=vpn.pcap_writer_enabled outcome=success session_id=\(ref.id.uuidString, privacy: .public) file=\(fileName, privacy: .public) mode=\(String(describing: mode), privacy: .public)"
+            )
+            return writer
+        } catch {
+            VPNLog.tunnel.error(
+                "event=vpn.pcap_writer_start outcome=failure session_id=\(ref.id.uuidString, privacy: .public) file=\(fileName, privacy: .public) error=\(String(describing: error), privacy: .public)"
+            )
+            return nil
+        }
+    }
+
+    /// Closes every PCAP writer this coordinator handed out.
+    func closeWriters() {
+        lock.lock()
+        let openWriters = writers
+        writers.removeAll()
+        lock.unlock()
+        for writer in openWriters.values {
+            writer.close()
+        }
+    }
+
+    /// Ends the session for this tunnel run and persists `endTime`, `endReason` and the traffic totals.
+    ///
+    /// - Important: Never overwrites an `endTime` / `endReason` the app already wrote (the user
+    ///   pressing Stop wins); only the statistics are refreshed.
+    @discardableResult
+    func finalize(endReason: SessionEndReason, at date: Date = Date()) -> CaptureSession? {
+        guard let ref = currentSession else {
+            closeWriters()
+            return nil
+        }
+
+        // Flush packet buffers before the file sizes are reported anywhere.
+        closeWriters()
+
+        let stored = loadSession(id: ref.id)
+        var updated = stored ?? CaptureSession(id: ref.id, startTime: ref.createdAt)
+        let stats = requestStats(for: ref)
+        let alreadyEnded = updated.endTime != nil
+
+        updated.requestCount = stats.requestCount
+        updated.totalDataTransferred = stats.totalBytes
+        if updated.endTime == nil {
+            updated.endTime = date
+            updated.endReason = endReason
+        }
+
+        do {
+            try storage.updateSessionStats(
+                id: ref.id,
+                requestCount: updated.requestCount,
+                totalBytes: updated.totalDataTransferred,
+                endTime: updated.endTime,
+                endReason: updated.endReason
+            )
+            // Point the record at the file that actually holds this session's packets.
+            let resolvedPCAPName = resolvePCAPFileName(for: ref)
+            if updated.pcapFileName != resolvedPCAPName {
+                updated.pcapFileName = resolvedPCAPName
+                try? storage.saveSession(updated)
+            }
+            try? SessionDirectory.writeMeta(updated, createdAt: ref.createdAt)
+            VPNLog.tunnel.info(
+                "event=vpn.capture_session outcome=ended session_id=\(ref.id.uuidString, privacy: .public) reason=\((updated.endReason ?? endReason).rawValue, privacy: .public) request_count=\(updated.requestCount) bytes=\(updated.totalDataTransferred) already_ended=\(alreadyEnded)"
+            )
+        } catch {
+            VPNLog.tunnel.error(
+                "event=vpn.capture_session outcome=finalize_failure session_id=\(ref.id.uuidString, privacy: .public) error=\(String(describing: error), privacy: .public)"
+            )
+        }
+
+        lock.lock()
+        session = nil
+        lock.unlock()
+        return updated
+    }
+
+    // MARK: - Helpers
+
+    /// Takes over the session the app created right before starting the tunnel, if there is one.
+    ///
+    /// The session a run belongs to is "the newest record without an end time". The app applies
+    /// exactly the same rule, so both sides agree without a hand-shake, and a tunnel restart
+    /// during a capture keeps writing to the same session instead of opening a second one.
+    private func adoptPendingSession() -> SessionRef? {
+        guard let sessions = try? storage.loadAllSessions() else { return nil }
+        // `loadAllSessions()` is ordered by start time, newest first.
+        guard let candidate = sessions.first(where: \.isActive) else { return nil }
+
+        // The app prepares the session directory; create it defensively for records that predate it.
+        let directory = SessionDirectory.directory(for: candidate.id, createdAt: candidate.startTime)
+        if !FileManager.default.fileExists(atPath: directory.path) {
+            _ = try? SessionDirectory.create(for: candidate.id, createdAt: candidate.startTime)
+            try? SessionDirectory.writeMeta(candidate, createdAt: candidate.startTime)
+        }
+        return SessionRef(id: candidate.id, createdAt: candidate.startTime)
+    }
+
+    /// Creates the session for runs the app did not announce (widget, Quick Action, system start).
+    private func createSession(now: Date) -> SessionRef? {
+        let newSession = CaptureSession(startTime: now)
+        do {
+            _ = try SessionDirectory.create(for: newSession.id, createdAt: newSession.startTime)
+            try storage.saveSession(newSession)
+            try? SessionDirectory.writeMeta(newSession, createdAt: newSession.startTime)
+            VPNLog.tunnel.info(
+                "event=vpn.capture_session outcome=created session_id=\(newSession.id.uuidString, privacy: .public) reason=no_pending_session"
+            )
+            return SessionRef(id: newSession.id, createdAt: newSession.startTime)
+        } catch {
+            VPNLog.tunnel.error(
+                "event=vpn.capture_session outcome=create_failure error=\(String(describing: error), privacy: .public)"
+            )
+            return nil
+        }
+    }
+
+    private func loadSession(id: UUID) -> CaptureSession? {
+        if let session = try? storage.session(id: id) {
+            return session
+        }
+        return (try? storage.loadAllSessions())?.first { $0.id == id }
+    }
+
+    /// Picks the file that holds this session's packets, preferring the HTTP-level capture.
+    private func resolvePCAPFileName(for ref: SessionRef) -> String {
+        let candidates = [Self.primaryPCAPFileName, Self.packetPCAPFileName]
+        for name in candidates {
+            let url = SessionDirectory.url(for: ref.id, createdAt: ref.createdAt, fileName: name)
+            let size = (try? FileManager.default.attributesOfItem(atPath: url.path)[.size] as? NSNumber)?
+                .uint64Value ?? 0
+            if size > 0 {
+                return name
+            }
+        }
+        return Self.primaryPCAPFileName
+    }
+
+    /// Totals for the session, derived from the stored requests of that session.
+    ///
+    /// Only requests recorded since the session started are read, which keeps the work small
+    /// inside the memory-constrained extension.
+    private func requestStats(for ref: SessionRef) -> (requestCount: Int, totalBytes: Int64) {
+        guard let requests = try? storage.loadRequests(newerThan: ref.createdAt) else {
+            return (0, 0)
+        }
+        var count = 0
+        var bytes: Int64 = 0
+        for request in requests where request.sessionId == ref.id {
+            count += 1
+            bytes += Int64(request.responseSize ?? 0)
+        }
+        return (count, bytes)
+    }
+}
