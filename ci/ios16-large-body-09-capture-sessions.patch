+//
+//  SessionRowView.swift
+//  Trace
+//
+//  One row of the capture session list, plus the shared status badge.
+//
+
+import SwiftUI
+import TraceCore
+import TraceUI
+
+// MARK: - Status badge
+
+/// Colour-coded pill describing the state of a capture session.
+struct SessionStatusBadge: View {
+    let status: CaptureSessionStatus
+
+    var body: some View {
+        HStack(spacing: DesignSystem.Spacing.xxs + 1) {
+            Image(systemName: iconName)
+                .font(.system(size: 9, weight: .bold))
+            Text(status.title)
+                .font(.caption2.weight(.semibold))
+        }
+        .foregroundStyle(tint)
+        .padding(.horizontal, DesignSystem.Spacing.smPlus)
+        .padding(.vertical, 3)
+        .background(Capsule(style: .continuous).fill(tint.opacity(0.15)))
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(Text(status.title))
+    }
+
+    private var tint: Color {
+        switch status {
+        case .active:
+            DesignSystem.Colors.danger
+        case .finished:
+            DesignSystem.Colors.success
+        case .interrupted:
+            DesignSystem.Colors.warning
+        }
+    }
+
+    private var iconName: String {
+        switch status {
+        case .active:
+            "record.circle.fill"
+        case .finished:
+            "checkmark.circle.fill"
+        case .interrupted:
+            "exclamationmark.triangle.fill"
+        }
+    }
+}
+
+// MARK: - Row
+
+/// A capture session as shown in the sessions list.
+///
+/// Shows the start time (relative and absolute), the duration, the request
+/// count, the transferred traffic and the size of the session's pcap file.
+struct SessionRowView: View {
+    let row: CaptureSessionRowModel
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: DesignSystem.Spacing.xs + 1) {
+            headerLine
+            timestampLine
+            metricsLine
+        }
+        .padding(.vertical, DesignSystem.Spacing.xxs)
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(Text(accessibilityDescription))
+    }
+
+    // MARK: Lines
+
+    private var headerLine: some View {
+        HStack(spacing: DesignSystem.Spacing.smPlus) {
+            SessionStatusBadge(status: row.status)
+
+            Text(row.displayTitle)
+                .font(.subheadline.weight(.semibold))
+                .lineLimit(1)
+
+            Spacer(minLength: DesignSystem.Spacing.xs)
+
+            Text(CaptureSessionFormat.relativeDate(row.session.startTime))
+                .font(.caption)
+                .foregroundStyle(.secondary)
+                .lineLimit(1)
+        }
+    }
+
+    private var timestampLine: some View {
+        HStack(spacing: DesignSystem.Spacing.xs) {
+            Text(CaptureSessionFormat.absoluteDate(row.session.startTime))
+                .font(.caption2)
+                .foregroundStyle(.secondary)
+                .lineLimit(1)
+                .minimumScaleFactor(0.8)
+
+            Spacer(minLength: DesignSystem.Spacing.xs)
+
+            Label {
+                Text(verbatim: CaptureSessionFormat.bytes(row.pcapBytes))
+            } icon: {
+                Image(systemName: "doc.text")
+            }
+            .font(.caption2)
+            .foregroundStyle(.secondary)
+            .lineLimit(1)
+        }
+    }
+
+    private var metricsLine: some View {
+        HStack(spacing: DesignSystem.Spacing.md) {
+            durationMetric
+
+            Label {
+                Text("\(row.requestCount) requests")
+            } icon: {
+                Image(systemName: "list.number")
+            }
+
+            Label {
+                Text(verbatim: CaptureSessionFormat.bytes(row.totalBytes))
+            } icon: {
+                Image(systemName: "arrow.up.arrow.down")
+            }
+        }
+        .font(.caption2)
+        .foregroundStyle(.secondary)
+        .lineLimit(1)
+        .minimumScaleFactor(0.85)
+    }
+
+    /// Recording sessions tick once a second; finished ones are static.
+    @ViewBuilder
+    private var durationMetric: some View {
+        if row.status == .active {
+            TimelineView(.periodic(from: .now, by: 1)) { context in
+                Label {
+                    Text(verbatim: CaptureSessionFormat.duration(row.session.duration(relativeTo: context.date)))
+                } icon: {
+                    Image(systemName: "clock")
+                }
+            }
+        } else {
+            Label {
+                Text(verbatim: CaptureSessionFormat.duration(row.session.duration))
+            } icon: {
+                Image(systemName: "clock")
+            }
+        }
+    }
+
+    private var accessibilityDescription: String {
+        [
+            row.status.title,
+            row.displayTitle,
+            "started \(CaptureSessionFormat.absoluteDate(row.session.startTime)) (\(CaptureSessionFormat.relativeDate(row.session.startTime)))",
+            "duration \(CaptureSessionFormat.duration(row.session.duration))",
+            "\(row.requestCount) requests",
+            "traffic \(CaptureSessionFormat.bytes(row.totalBytes))",
+            "pcap \(CaptureSessionFormat.bytes(row.pcapBytes))",
+        ].joined(separator: ", ")
+    }
+}
+
+// MARK: - Previews
+
+#if DEBUG
+extension CaptureSessionRowModel {
+    static func preview(
+        status: CaptureSessionStatus,
+        startTime: Date = Date().addingTimeInterval(-740),
+        endTime: Date? = Date().addingTimeInterval(-90),
+        endReason: SessionEndReason? = .userStopped
+    ) -> CaptureSessionRowModel {
+        let session = CaptureSession(
+            name: nil,
+            startTime: startTime,
+            endTime: status == .active ? nil : endTime,
+            requestCount: 128,
+            totalDataTransferred: 4_820_000
+        )
+        var configured = session
+        configured.endReason = status == .interrupted ? .interrupted : endReason
+        return CaptureSessionRowModel(
+            session: configured,
+            requestCount: 128,
+            totalBytes: 4_820_000,
+            pcapBytes: 2_310_000,
+            status: status
+        )
+    }
+}
+#endif
+
+#if DEBUG
+#Preview("Session Rows") {
+    List {
+        SessionRowView(row: .preview(status: .active, endTime: nil))
+        SessionRowView(row: .preview(status: .finished))
+        SessionRowView(row: .preview(status: .interrupted))
+    }
+    .listStyle(.insetGrouped)
+}
+
+#Preview("Status Badges") {
+    HStack(spacing: DesignSystem.Spacing.sm) {
+        SessionStatusBadge(status: .active)
+        SessionStatusBadge(status: .finished)
+        SessionStatusBadge(status: .interrupted)
+    }
+    .padding()
+}
+#endif
