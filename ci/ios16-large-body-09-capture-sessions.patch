+        try saveSession(session)
+        CoreLog.storage.info(
+            "event=storage.session_stats_update outcome=success session_id=\(id.uuidString, privacy: .public) requests=\(session.requestCount, privacy: .public) bytes=\(session.totalDataTransferred, privacy: .public) ended=\(endTime != nil, privacy: .public)"
+        )
+    }
+
+    /// 删会话行 + 会话目录（`meta.json`、pcap 一起删）。
+    ///
+    /// 只负责会话本身：`network_requests` 里的请求由请求侧删除（见 `deleteCapturedRequests(forSession:)`
+    /// 或 `AppGroupCaptureStore.deleteSessionAndFiles(_:)`）。
+    /// 会话行删除成功后目录删除失败会抛错，调用方据此可以提示「文件残留」。
+    func deleteSessionAndFiles(_ sessionID: UUID) throws {
+        let startedAt = (try? session(id: sessionID))?.startTime ?? Date()
+        try deleteSession(sessionID)
+        // deleteSession 已经 best-effort 删过一次，这里再删一次把失败暴露给调用方（重复删除是幂等的）。
+        try SessionDirectory.delete(for: sessionID, createdAt: startedAt)
+        CoreLog.storage.info("event=storage.session_delete_with_files outcome=success session_id=\(sessionID.uuidString, privacy: .public)")
+    }
+
+    /// 删会话行 + 会话目录（便捷重载）。
+    func deleteSessionAndFiles(_ session: CaptureSession) throws {
+        try deleteSessionAndFiles(session.id)
+    }
+
+    /// 删掉所有会话行与所有会话目录（用于「清空抓包记录」）。
+    ///
+    /// 注意：不动 `network_requests`，调用方需要先清请求。
+    func deleteAllSessionsAndFiles() throws {
+        let sessions = try loadAllSessions()
+        let didWrite = executeDBWrite { db in
+            try db.execute(sql: "DELETE FROM capture_sessions")
+        }
+        if !didWrite {
+            throw StorageError.databaseUnavailable
+        }
+        for session in sessions {
+            deleteSessionDirectoryBestEffort(session.id, createdAt: session.startTime)
+        }
+        // 库里已经没有会话，剩下的会话目录一律按孤儿清理。
+        for directory in SessionDirectory.orphanDirectories(existing: []) {
+            try? FileManager.default.removeItem(at: directory)
+        }
+        CoreLog.storage.info("event=storage.session_delete_all_with_files outcome=success count=\(sessions.count, privacy: .public)")
+    }
+
+    /// 删除某个会话的全部请求（含请求/响应 body 文件），其他会话的 body 文件不受影响。
+    ///
+    /// - Returns: 删除的请求条数。
+    @discardableResult
+    func deleteCapturedRequests(forSession sessionID: UUID) throws -> Int {
+        do {
+            return try withDatabase { pool -> Int in
+                try pool.write { db -> Int in
+                    let rows = try Row.fetchAll(
+                        db,
+                        sql: "SELECT payload FROM network_requests WHERE session_id = ?",
+                        arguments: [sessionID.uuidString]
+                    )
+                    let decoder = makeDecoder()
+                    for row in rows {
+                        let payload: Data = row["payload"]
+                        guard let request = try? decoder.decode(NetworkRequest.self, from: payload) else { continue }
+                        request.requestBody.deleteFile()
+                        request.responseBody.deleteFile()
+                    }
+                    try db.execute(
+                        sql: "DELETE FROM network_requests WHERE session_id = ?",
+                        arguments: [sessionID.uuidString]
+                    )
+                    return rows.count
+                }
+            }
+        } catch {
+            throw mapDatabaseError(error)
+        }
+    }
+}
+
+// MARK: - 会话目录 best-effort 辅助
+
+/// 写 `meta.json`，失败只记日志：会话的权威数据在 GRDB，meta 只是给用户/排障看的一份快照。
+private func writeCaptureSessionMetaBestEffort(_ session: CaptureSession) {
+    do {
+        try SessionDirectory.writeMeta(session, createdAt: session.startTime)
+    } catch {
+        CoreLog.storage.error(
+            "event=storage.session_meta_write outcome=failure session_id=\(session.id.uuidString, privacy: .public) error=\(String(describing: error), privacy: .public)"
+        )
+    }
+}
+
+private func deleteSessionDirectoryBestEffort(_ sessionID: UUID, createdAt: Date) {
+    do {
+        try SessionDirectory.delete(for: sessionID, createdAt: createdAt)
+    } catch {
+        CoreLog.storage.error(
+            "event=storage.session_directory_delete outcome=failure session_id=\(sessionID.uuidString, privacy: .public) error=\(String(describing: error), privacy: .public)"
+        )
+    }
+}
