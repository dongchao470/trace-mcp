--- /dev/null
+++ b/TraceCore/Storage/SessionDirectory.swift
@@ -0,0 +1,234 @@
+//
+//  SessionDirectory.swift
+//  TraceCore
+//
+//  Created by Justin on 2026/11/26.
+//
+
+import Foundation
+import OSLog
+
+/// 抓包会话在 App Group 容器里的落盘目录。
+///
+/// 布局：
+/// ```
+/// <App Group 容器>/Sessions/<yyyyMMdd-HHmmss>-<uuid 前 8 位>/
+///     ├─ http.pcap
+///     └─ meta.json      // 整份 CaptureSession 的 JSON
+/// ```
+///
+/// 目录名里的时间戳固定用 UTC + `en_US_POSIX` 格式化：同一个会话在任何时区、任何地区设置下
+/// 都能算回同一条路径，否则「创建时在 A 时区、删除时在 B 时区」会算出两个目录。
+public struct SessionDirectory {
+    /// 容器下的会话根目录名。
+    public static let rootDirectoryName = "Sessions"
+    /// 元数据文件名。
+    public static let metaFileName = "meta.json"
+
+    private static let idPrefixLength = 8
+    /// 目录名长度：`yyyyMMdd-HHmmss`（15）+ `-`（1）+ uuid 前缀（8）。
+    private static let directoryNameLength = 24
+
+    // MARK: - 路径
+
+    /// 会话根目录：`<App Group 容器>/Sessions`。
+    ///
+    /// App Group 不可用（模拟器/测试/配置错误）时退回临时目录，任何情况下都返回一个可用路径。
+    public static func root() -> URL {
+        if let container = AppGroupStorage.shared.containerURL {
+            return container.appendingPathComponent(rootDirectoryName, isDirectory: true)
+        }
+        return FileManager.default.temporaryDirectory
+            .appendingPathComponent("TraceSessions", isDirectory: true)
+    }
+
+    /// 指定会话的目录：`root()/<yyyyMMdd-HHmmss>-<uuid 前 8 位>`。
+    public static func directory(for id: UUID, createdAt: Date) -> URL {
+        let name = "\(TimestampFormatter.shared.string(from: createdAt))-\(idPrefix(of: id))"
+        return root().appendingPathComponent(name, isDirectory: true)
+    }
+
+    /// 指定会话的目录（便捷重载，`createdAt` 取 `session.startTime`）。
+    public static func directory(for session: CaptureSession) -> URL {
+        directory(for: session.id, createdAt: session.startTime)
+    }
+
+    /// 创建会话目录（含中间目录），返回该目录。已存在时直接返回。
+    @discardableResult
+    public static func create(for id: UUID, createdAt: Date) throws -> URL {
+        let directory = directory(for: id, createdAt: createdAt)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory
+    }
+
+    /// 会话目录内某个文件的路径（不保证已存在）。
+    public static func url(for id: UUID, createdAt: Date, fileName: String) -> URL {
+        directory(for: id, createdAt: createdAt).appendingPathComponent(fileName)
+    }
+
+    /// 会话默认 pcap 的路径：`<会话目录>/http.pcap`。
+    public static func pcapURL(for id: UUID, createdAt: Date) -> URL {
+        url(for: id, createdAt: createdAt, fileName: CaptureSession.defaultPCAPFileName)
+    }
+
+    /// 会话 pcap 的路径，遵循 `session.pcapFileName`（缺省 `http.pcap`）。
+    public static func pcapURL(for session: CaptureSession) -> URL {
+        let fileName = session.pcapFileName ?? CaptureSession.defaultPCAPFileName
+        return url(for: session.id, createdAt: session.startTime, fileName: fileName)
+    }
+
+    /// 会话 meta.json 的路径。
+    public static func metaURL(for id: UUID, createdAt: Date) -> URL {
+        url(for: id, createdAt: createdAt, fileName: metaFileName)
+    }
+
+    // MARK: - 元数据
+
+    /// 把整份 `CaptureSession` 写成 `meta.json`（原子写）。
+    ///
+    /// 目录不存在时会先创建，调用方不必预先 `create`。
+    public static func writeMeta(_ session: CaptureSession, createdAt: Date) throws {
+        let directory = try create(for: session.id, createdAt: createdAt)
+        let data: Data
+        do {
+            data = try JSONCoding.makeEncoder().encode(session)
+        } catch {
+            throw StorageError.encodingFailed
+        }
+        try data.write(to: directory.appendingPathComponent(metaFileName), options: .atomic)
+    }
+
+    /// 读回 `meta.json`；文件缺失或内容损坏时返回 `nil`。
+    public static func readMeta(for id: UUID, createdAt: Date) -> CaptureSession? {
+        guard let data = try? Data(contentsOf: metaURL(for: id, createdAt: createdAt)) else {
+            return nil
+        }
+        return try? JSONCoding.makeDecoder().decode(CaptureSession.self, from: data)
+    }
+
+    // MARK: - 体积
+
+    /// 会话目录内所有文件的总字节数（含 meta.json）；目录不存在时返回 0。
+    public static func totalSize(for id: UUID, createdAt: Date) -> Int64 {
+        size(of: directory(for: id, createdAt: createdAt))
+    }
+
+    /// 单个 pcap 文件的字节数；文件不存在时返回 0。
+    public static func pcapSize(for id: UUID, createdAt: Date) -> Int64 {
+        let attributes = try? FileManager.default.attributesOfItem(atPath: pcapURL(for: id, createdAt: createdAt).path)
+        return (attributes?[.size] as? NSNumber)?.int64Value ?? 0
+    }
+
+    // MARK: - 删除
+
+    /// 删除会话目录。目录不存在时静默返回，可重复调用。
+    ///
+    /// 先按当前命名规则精确删除；找不到时再按 uuid 前缀扫一遍，容忍历史/未来命名差异造成的目录名漂移。
+    public static func delete(for id: UUID, createdAt: Date) throws {
+        let fileManager = FileManager.default
+        let directory = directory(for: id, createdAt: createdAt)
+        if fileManager.fileExists(atPath: directory.path) {
+            try fileManager.removeItem(at: directory)
+            return
+        }
+        let matches = sessionDirectories().filter { candidate in
+            idPrefix(fromDirectoryName: candidate.lastPathComponent) == idPrefix(of: id)
+        }
+        for candidate in matches {
+            try fileManager.removeItem(at: candidate)
+        }
+    }
+
+    /// 兜底清理：容器里存在、但库里已经没有对应会话的目录。
+    ///
+    /// 目录名只带 uuid 的前 8 位，因此按前缀比对（同前缀碰撞概率可忽略）。
+    /// 名字不符合 `<时间戳>-<uuid 前 8 位>` 的目录不会被返回，避免误删别的东西。
+    public static func orphanDirectories(existing: Set<UUID>) -> [URL] {
+        let knownPrefixes = Set(existing.map { idPrefix(of: $0) })
+        return sessionDirectories().filter { directory in
+            guard let prefix = idPrefix(fromDirectoryName: directory.lastPathComponent) else {
+                return false
+            }
+            return !knownPrefixes.contains(prefix)
+        }
+    }
+
+    // MARK: - 内部实现
+
+    private static func size(of directory: URL) -> Int64 {
+        let fileManager = FileManager.default
+        guard fileManager.fileExists(atPath: directory.path) else {
+            return 0
+        }
+        let keys: Set<URLResourceKey> = [.isRegularFileKey, .fileSizeKey]
+        guard let enumerator = fileManager.enumerator(
+            at: directory,
+            includingPropertiesForKeys: Array(keys),
+            options: [.skipsHiddenFiles]
+        ) else {
+            return 0
+        }
+        var total: Int64 = 0
+        for case let fileURL as URL in enumerator {
+            guard let values = try? fileURL.resourceValues(forKeys: keys), values.isRegularFile == true else {
+                continue
+            }
+            total += Int64(values.fileSize ?? 0)
+        }
+        return total
+    }
+
+    /// `root()` 下的所有子目录；根目录不存在时返回空数组。
+    private static func sessionDirectories() -> [URL] {
+        let fileManager = FileManager.default
+        guard let entries = try? fileManager.contentsOfDirectory(
+            at: root(),
+            includingPropertiesForKeys: [.isDirectoryKey],
+            options: [.skipsHiddenFiles]
+        ) else {
+            return []
+        }
+        return entries.filter { entry in
+            (try? entry.resourceValues(forKeys: [.isDirectoryKey]).isDirectory) == true
+        }
+    }
+
+    private static func idPrefix(of id: UUID) -> String {
+        String(id.uuidString.prefix(idPrefixLength)).lowercased()
+    }
+
+    /// 从目录名 `<yyyyMMdd-HHmmss>-<uuid 前 8 位>` 取出 uuid 前缀；格式不符返回 `nil`。
+    private static func idPrefix(fromDirectoryName name: String) -> String? {
+        guard name.count == directoryNameLength, let separator = name.lastIndex(of: "-") else {
+            return nil
+        }
+        let prefix = name[name.index(after: separator)...]
+        guard prefix.count == idPrefixLength, prefix.allSatisfy({ $0.isHexDigit }) else {
+            return nil
+        }
+        return prefix.lowercased()
+    }
+
+    /// `DateFormatter` 不是 Sendable，用锁包一层（同 `JSONCoding.DateParser` 的做法），
+    /// 既让 `static let` 在 Swift 6 语言模式下合法，也保证多线程格式化安全。
+    private final class TimestampFormatter: @unchecked Sendable {
+        static let shared = TimestampFormatter()
+
+        private let lock = NSLock()
+        private let formatter: DateFormatter
+
+        init() {
+            let formatter = DateFormatter()
+            formatter.locale = Locale(identifier: "en_US_POSIX")
+            formatter.timeZone = TimeZone(secondsFromGMT: 0)
+            formatter.dateFormat = "yyyyMMdd-HHmmss"
+            self.formatter = formatter
+        }
+
+        func string(from date: Date) -> String {
+            lock.lock()
+            defer { lock.unlock() }
+            return formatter.string(from: date)
+        }
+    }
+}
