+/// Opens and closes the capture record around a real capture run.
+///
+/// Discussion: The capture session belongs to a run of the tunnel, so it is created when capture
+/// starts and closed when it stops — never at app launch, in previews, or while browsing requests.
+@MainActor
+protocol CaptureSessionCoordinating: AnyObject {
+    /// Opens the record for the run that is starting now.
+    func beginCaptureSession()
+    /// Removes the record when the tunnel never came up.
+    func abortCaptureSession()
+    /// Closes the record with `reason` and the totals of the run.
+    func endCaptureSession(reason: SessionEndReason)
+}
