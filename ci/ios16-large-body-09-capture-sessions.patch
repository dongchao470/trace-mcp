new file mode 100644
index 0000000..48e6eb0
--- /dev/null
+++ b/Trace/ViewModels/SessionListViewModel.swift
@@ -0,0 +1,503 @@
+//
+//  SessionListViewModel.swift
+//  Trace
+//
+//  Capture session records: list + detail data access, formatting helpers and
+//  the on-disk session folder lookups.
+//
+
+import Combine
+import Foundation
+import TraceCore
+import os
+import TraceCore
+
+// MARK: - Status
+
+/// Presentation status of a capture session record.
+///
+/// A session with `endTime == nil` is still recording; a session that was
+/// closed by the recovery pass carries `endReason == .interrupted`.
+enum CaptureSessionStatus: Equatable, Sendable {
+    case active
+    case finished
+    case interrupted
+
+    init(session: CaptureSession) {
+        if session.isActive {
+            self = .active
+        } else if session.endReason == .interrupted {
+            self = .interrupted
+        } else {
+            self = .finished
+        }
+    }
+
+    var title: String {
+        switch self {
+        case .active:
+            String(localized: "Recording")
+        case .finished:
+            String(localized: "Finished")
+        case .interrupted:
+            String(localized: "Interrupted")
+        }
+    }
+}
+
+// MARK: - Row model
+
+/// Everything a session row needs, resolved off the main thread before display.
+struct CaptureSessionRowModel: Identifiable, Equatable, Sendable {
+    let session: CaptureSession
+    let requestCount: Int
+    let totalBytes: Int64
+    let pcapBytes: Int64
+    let status: CaptureSessionStatus
+
+    var id: UUID {
+        session.id
+    }
+
+    var shortIdentifier: String {
+        String(session.id.uuidString.prefix(8))
+    }
+
+    var displayTitle: String {
+        CaptureSessionNaming.displayTitle(for: session)
+    }
+}
+
+/// Shared title rules for session records.
+enum CaptureSessionNaming {
+    static func displayTitle(for session: CaptureSession) -> String {
+        if let name = session.name?.trimmingCharacters(in: .whitespacesAndNewlines), !name.isEmpty {
+            return name
+        }
+        let shortIdentifier = String(session.id.uuidString.prefix(8))
+        return String(localized: "Session") + " " + shortIdentifier
+    }
+}
+
+// MARK: - Storage access
+
+/// Nonisolated storage and file helpers shared by the session list and detail screens.
+///
+/// The session screens read the shared store directly instead of going through
+/// `CaptureViewModel`, so they keep working while capture is idle or stopped.
+enum CaptureSessionStore {
+    static func fetchRows(storage: AppGroupStorage) throws -> [CaptureSessionRowModel] {
+        let sessions = try storage.loadAllSessions()
+        return sessions.map { session in
+            var requestCount = session.requestCount
+            var totalBytes = session.totalDataTransferred
+
+            // Sessions that never finished (still recording or interrupted) have no
+            // finalized statistics, so fall back to counting their stored requests.
+            if requestCount <= 0,
+               let requests = try? storage.loadRequestsForSession(session.id),
+               !requests.isEmpty
+            {
+                requestCount = requests.count
+                totalBytes = requests.reduce(Int64(0)) { partial, request in
+                    partial + Int64(request.responseSize ?? request.requestSize ?? 0)
+                }
+            }
+
+            return CaptureSessionRowModel(
+                session: session,
+                requestCount: requestCount,
+                totalBytes: totalBytes,
+                pcapBytes: CaptureSessionFiles.pcapFileSize(for: session),
+                status: CaptureSessionStatus(session: session)
+            )
+        }
+    }
+
+    static func fetchRequests(storage: AppGroupStorage, sessionID: UUID) throws -> [NetworkRequest] {
+        try storage.loadRequestsForSession(sessionID)
+    }
+
+    static func fetchSession(storage: AppGroupStorage, sessionID: UUID) throws -> CaptureSession? {
+        try storage.loadAllSessions().first { $0.id == sessionID }
+    }
+
+    /// Deletes the session's requests, then the session record, then its folder.
+    ///
+    /// Requests are removed one by one so their body files are cleaned up with
+    /// them. If any request cannot be deleted the session record is kept, which
+    /// leaves the row visible so the user can retry.
+    static func deleteSessionAndFiles(storage: AppGroupStorage, session: CaptureSession) throws {
+        let requests = (try? storage.loadRequestsForSession(session.id)) ?? []
+        var failures = 0
+        for request in requests {
+            do {
+                try storage.deleteRequest(request)
+            } catch {
+                failures += 1
+            }
+        }
+        guard failures == 0 else {
+            throw CaptureSessionDeleteError.requestsNotDeleted(failed: failures, total: requests.count)
+        }
+
+        try storage.deleteSession(session.id)
+        CaptureSessionFiles.removeDirectory(for: session)
+    }
+}
+
+enum CaptureSessionDeleteError: LocalizedError {
+    case requestsNotDeleted(failed: Int, total: Int)
+
+    var errorDescription: String? {
+        switch self {
+        case let .requestsNotDeleted(failed, total):
+            return String(localized: "\(failed) of \(total) requests could not be deleted. Nothing else was removed, please try again.")
+        }
+    }
+}
+
+// MARK: - Session files
+
+/// Resolves the on-disk artefacts that belong to a capture session.
+enum CaptureSessionFiles {
+    static let defaultPCAPFileName = "http.pcap"
+
+    static func pcapFileName(for session: CaptureSession) -> String {
+        if let name = session.pcapFileName, !name.isEmpty {
+            return name
+        }
+        return defaultPCAPFileName
+    }
+
+    /// Folder that owns the session's pcap and meta files.
+    ///
+    /// The canonical location is derived from the session id + start time; when
+    /// that folder is missing (older records, or a folder named from a slightly
+    /// different timestamp) the folder is matched by its trailing UUID prefix.
+    static func directoryURL(for session: CaptureSession) -> URL? {
+        let expected = SessionDirectory.directory(for: session.id, createdAt: session.startTime)
+        if FileManager.default.fileExists(atPath: expected.path) {
+            return expected
+        }
+
+        let root = SessionDirectory.root()
+        guard let entries = try? FileManager.default.contentsOfDirectory(at: root, includingPropertiesForKeys: nil) else {
+            return nil
+        }
+        let suffix = "-" + session.id.uuidString.prefix(8).lowercased()
+        return entries.first { entry in
+            entry.lastPathComponent.lowercased().hasSuffix(suffix)
+        }
+    }
+
+    static func pcapURL(for session: CaptureSession) -> URL? {
+        let fileName = pcapFileName(for: session)
+
+        if let directory = directoryURL(for: session) {
+            let candidate = directory.appendingPathComponent(fileName)
+            if FileManager.default.fileExists(atPath: candidate.path) {
+                return candidate
+            }
+            if let contents = try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil),
+               let fallback = contents.first(where: { $0.pathExtension.lowercased() == "pcap" })
+            {
+                return fallback
+            }
+            return nil
+        }
+
+        let direct = SessionDirectory.url(for: session.id, createdAt: session.startTime, fileName: fileName)
+        if FileManager.default.fileExists(atPath: direct.path) {
+            return direct
+        }
+        return nil
+    }
+
+    static func pcapFileSize(for session: CaptureSession) -> Int64 {
+        guard let url = pcapURL(for: session) else { return 0 }
+        if let values = try? url.resourceValues(forKeys: [.fileSizeKey]), let fileSize = values.fileSize {
+            return Int64(fileSize)
+        }
+        guard let attributes = try? FileManager.default.attributesOfItem(atPath: url.path) else { return 0 }
+        return (attributes[.size] as? NSNumber)?.int64Value ?? 0
+    }
+
+    /// Best-effort folder removal. Failure is logged but never fatal: at this
+    /// point the session record is already gone and must stay gone.
+    @discardableResult
+    static func removeDirectory(for session: CaptureSession) -> Bool {
+        guard let directory = directoryURL(for: session) else { return true }
+        do {
+            try FileManager.default.removeItem(at: directory)
+            return true
+        } catch {
+            CoreLog.storage.error(
+                "event=session_directory_delete outcome=failure session_id=\(session.id.uuidString, privacy: .public) error=\(error.localizedDescription, privacy: .public)"
+            )
+            return false
+        }
+    }
+}
+
+// MARK: - Formatting
+
+/// Formatters used by the session screens.
+///
+/// Kept on the main actor because the cached `DateFormatter` and
+/// `RelativeDateTimeFormatter` instances are not thread-safe.
+@MainActor
+enum CaptureSessionFormat {
+    private static let absoluteDateFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.dateStyle = .medium
+        formatter.timeStyle = .medium
+        return formatter
+    }()
+
+    private static let shortDateFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.dateStyle = .short
+        formatter.timeStyle = .short
+        return formatter
+    }()
+
+    private static let relativeDateFormatter: RelativeDateTimeFormatter = {
+        let formatter = RelativeDateTimeFormatter()
+        formatter.unitsStyle = .abbreviated
+        return formatter
+    }()
+
+    static func absoluteDate(_ date: Date) -> String {
+        absoluteDateFormatter.string(from: date)
+    }
+
+    static func shortDate(_ date: Date) -> String {
+        shortDateFormatter.string(from: date)
+    }
+
+    static func relativeDate(_ date: Date) -> String {
+        relativeDateFormatter.localizedString(for: date, relativeTo: Date())
+    }
+
+    static func duration(_ interval: TimeInterval) -> String {
+        let totalSeconds = max(0, Int(interval.rounded(.down)))
+        let hours = totalSeconds / 3600
+        let minutes = totalSeconds / 60 % 60
+        let seconds = totalSeconds % 60
+        if hours > 0 {
+            return String(format: "%dh %02dm %02ds", hours, minutes, seconds)
+        }
+        if minutes > 0 {
+            return String(format: "%dm %02ds", minutes, seconds)
+        }
+        return String(format: "%ds", seconds)
+    }
+
+    static func bytes(_ count: Int64) -> String {
+        ByteCountFormatter.string(fromByteCount: max(0, count), countStyle: .file)
+    }
+
+    static func endReason(_ reason: SessionEndReason?) -> String? {
+        guard let reason else { return nil }
+        switch reason {
+        case .userStopped:
+            return String(localized: "Stopped by user")
+        case .appTerminated:
+            return String(localized: "App closed while recording")
+        case .interrupted:
+            return String(localized: "Interrupted (unexpected exit)")
+        @unknown default:
+            return nil
+        }
+    }
+}
+
+// MARK: - List view model
+
+@MainActor
+final class SessionListViewModel: ObservableObject {
+    enum LoadState: Equatable {
+        case idle
+        case loading
+        case loaded
+        case failed(String)
+
+        var errorMessage: String? {
+            if case let .failed(message) = self {
+                return message
+            }
+            return nil
+        }
+    }
+
+    @Published private(set) var rows: [CaptureSessionRowModel] = []
+    @Published private(set) var loadState: LoadState = .idle
+    @Published private(set) var deletingIDs: Set<UUID> = []
+
+    private let storage: AppGroupStorage
+    private var hasLoadedOnce = false
+    private var isFetching = false
+
+    init(storage: AppGroupStorage = .shared) {
+        self.storage = storage
+    }
+
+    var hasActiveSession: Bool {
+        rows.contains { $0.status == .active }
+    }
+
+    var isLoading: Bool {
+        loadState == .loading
+    }
+
+    func loadIfNeeded() async {
+        guard !hasLoadedOnce else { return }
+        await reload(showSpinner: true)
+    }
+
+    /// Reloads the session list. `showSpinner == false` keeps the current
+    /// content on screen, which is what the auto refresh and pull-to-refresh use.
+    func reload(showSpinner: Bool) async {
+        guard !isFetching else { return }
+        isFetching = true
+        defer { isFetching = false }
+
+        if showSpinner || (!hasLoadedOnce && rows.isEmpty) {
+            loadState = .loading
+        }
+
+        do {
+            let storage = storage
+            let rows = try await Task.detached(priority: .userInitiated) {
+                try CaptureSessionStore.fetchRows(storage: storage)
+            }.value
+            self.rows = rows
+            self.loadState = .loaded
+            self.hasLoadedOnce = true
+        } catch {
+            CoreLog.storage.error(
+                "event=sessions_load outcome=failure error=\(error.localizedDescription, privacy: .public)"
+            )
+            self.loadState = .failed(error.localizedDescription)
+        }
+    }
+
+    /// Deletes the session record, its requests and its folder.
+    /// - Returns: An error message when the deletion failed, `nil` on success.
+    func delete(_ row: CaptureSessionRowModel) async -> String? {
+        guard !row.session.isActive else {
+            return String(localized: "Stop capturing before deleting this session.")
+        }
+        guard !deletingIDs.contains(row.id) else { return nil }
+
+        deletingIDs.insert(row.id)
+        defer { deletingIDs.remove(row.id) }
+
+        do {
+            let storage = storage
+            let session = row.session
+            try await Task.detached(priority: .userInitiated) {
+                try CaptureSessionStore.deleteSessionAndFiles(storage: storage, session: session)
+            }.value
+            rows.removeAll { $0.id == row.id }
+            return nil
+        } catch {
+            CoreLog.storage.error(
+                "event=sessions_delete outcome=failure session_id=\(row.id.uuidString, privacy: .public) error=\(error.localizedDescription, privacy: .public)"
+            )
+            return error.localizedDescription
+        }
+    }
+}
+
+// MARK: - Detail view model
+
+@MainActor
+final class SessionDetailViewModel: ObservableObject {
+    enum LoadState: Equatable {
+        case idle
+        case loading
+        case loaded
+        case failed(String)
+
+        var errorMessage: String? {
+            if case let .failed(message) = self {
+                return message
+            }
+            return nil
+        }
+    }
+
+    @Published private(set) var session: CaptureSession
+    @Published private(set) var requests: [NetworkRequest] = []
+    @Published private(set) var pcapBytes: Int64 = 0
+    @Published private(set) var loadState: LoadState = .idle
+
+    private let storage: AppGroupStorage
+    private var hasLoadedOnce = false
+    private var isFetching = false
+
+    init(session: CaptureSession, storage: AppGroupStorage = .shared) {
+        self.session = session
+        self.storage = storage
+    }
+
+    var status: CaptureSessionStatus {
+        CaptureSessionStatus(session: session)
+    }
+
+    var displayTitle: String {
+        CaptureSessionNaming.displayTitle(for: session)
+    }
+
+    var shortIdentifier: String {
+        String(session.id.uuidString.prefix(8))
+    }
+
+    var pcapFileName: String {
+        CaptureSessionFiles.pcapFileName(for: session)
+    }
+
+    var endReasonText: String? {
+        CaptureSessionFormat.endReason(session.endReason)
+    }
+
+    func loadIfNeeded() async {
+        guard !hasLoadedOnce else { return }
+        await reload(showSpinner: true)
+    }
+
+    func reload(showSpinner: Bool) async {
+        guard !isFetching else { return }
+        isFetching = true
+        defer { isFetching = false }
+
+        if showSpinner || (!hasLoadedOnce && requests.isEmpty) {
+            loadState = .loading
+        }
+
+        do {
+            let storage = storage
+            let sessionID = session.id
+            let fallback = session
+            let result = try await Task.detached(priority: .userInitiated) {
+                let refreshed = try CaptureSessionStore.fetchSession(storage: storage, sessionID: sessionID) ?? fallback
+                let requests = try CaptureSessionStore.fetchRequests(storage: storage, sessionID: sessionID)
+                let pcapBytes = CaptureSessionFiles.pcapFileSize(for: refreshed)
+                return (refreshed, requests, pcapBytes)
+            }.value
+
+            session = result.0
+            requests = result.1
+            pcapBytes = result.2
+            loadState = .loaded
+            hasLoadedOnce = true
+        } catch {
+            CoreLog.storage.error(
+                "event=sessions_detail_load outcome=failure session_id=\(self.session.id.uuidString, privacy: .public) error=\(error.localizedDescription, privacy: .public)"
+            )
+            loadState = .failed(error.localizedDescription)
+        }
+    }
+}
