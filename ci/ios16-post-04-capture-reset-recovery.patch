diff --git a/TraceCore/Models/CaptureHomeScope.swift b/TraceCore/Models/CaptureHomeScope.swift
--- a/TraceCore/Models/CaptureHomeScope.swift
+++ b/TraceCore/Models/CaptureHomeScope.swift
@@ -1,4 +1,38 @@
 import Foundation
+
+/// Process-local permission to present a newly created capture. Never persisted.
+/// Restoring or reusing a stored session does not grant presentation permission.
+public struct CaptureHomeLifecycle: Equatable, Sendable {
+    public struct Token: Equatable, Sendable {
+        public let sessionID: UUID
+        public let generation: UInt64
+    }
+
+    public private(set) var sessionID: UUID?
+    public private(set) var generation: UInt64 = 0
+
+    public init() {}
+
+    public var token: Token? {
+        guard let sessionID else { return nil }
+        return Token(sessionID: sessionID, generation: generation)
+    }
+
+    public mutating func beginSession(sessionID: UUID, isNewSession: Bool) {
+        guard isNewSession else { return }
+        generation &+= 1
+        self.sessionID = sessionID
+    }
+
+    public mutating func close() {
+        generation &+= 1
+        sessionID = nil
+    }
+
+    public func accepts(_ token: Token) -> Bool {
+        self.token == token
+    }
+}
 
 /// The single capture run visible on the home screen. History remains in storage.
 public struct CaptureHomeScope: Equatable, Sendable {
