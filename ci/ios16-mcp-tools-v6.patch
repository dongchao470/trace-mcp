+    private func matchEvidence(in request: NetworkRequest, query: String, scope: String, reveal: Bool) -> JSONValue? {
+        if scope == "url" || scope == "all" {
+            if request.url.localizedCaseInsensitiveContains(query) {
+                return .object([
+                    "field": .string("url"),
+                    "value": .string(request.url),
+                ])
+            }
+        }
+        if scope == "headers" || scope == "all" {
+            for header in request.requestHeaders + request.responseHeaders {
+                guard header.key.localizedCaseInsensitiveContains(query) || header.value.localizedCaseInsensitiveContains(query) else {
+                    continue
+                }
+                let sensitive = Self.sensitiveHeaderNames.contains(header.key.lowercased())
+                let masked = sensitive && !reveal
+                return .object([
+                    "field": .string("header"),
+                    "name": .string(header.key),
+                    "masked": .bool(masked),
+                    "value": .string(masked ? Self.maskValue(header.value) : Self.truncate(header.value, limit: 240)),
+                ])
+            }
+        }
+        if scope == "body" || scope == "all" {
+            for (label, body) in [("request_body", request.requestBody), ("response_body", request.responseBody)] {
+                guard let bodyText = body.getString(maxBytes: 512 * 1024), bodyText.localizedCaseInsensitiveContains(query) else {
+                    continue
+                }
+                return .object([
+                    "field": .string(label),
+                    "bytes": .number(Double(body.totalSize)),
+                    "snippet": .string(Self.snippet(bodyText, around: query)),
+                ])
+            }
+        }
+        return nil
+    }
+
+    private func parseDateArg(_ raw: String?) -> Date? {
+        guard let raw, !raw.isEmpty else { return nil }
+        let lowered = raw.lowercased()
+        if let unit = lowered.last, let amount = Int(lowered.dropLast()), amount > 0 {
+            let seconds: TimeInterval
+            switch unit {
+            case "m": seconds = 60
+            case "h": seconds = 3600
+            case "d": seconds = 86400
+            default: seconds = 0
+            }
+            if seconds > 0 { return Date().addingTimeInterval(-Double(amount) * seconds) }
+        }
+        if let date = isoFormatter.date(from: raw) { return date }
+        return ISO8601DateFormatter().date(from: raw)
+    }
+
+    private static let sensitiveHeaderNames: Set<String> = [
+        "cookie", "set-cookie", "authorization", "proxy-authorization",
+        "x-api-key", "x-auth-token", "x-access-token", "token",
+    ]
+
+    private static func maskValue(_ value: String) -> String {
+        guard value.count > 12 else { return "***" }
+        return String(value.prefix(4)) + "…" + String(value.suffix(3)) + " (\(value.count) 字符)"
+    }
+
+    private static func truncate(_ value: String, limit: Int) -> String {
+        value.count <= limit ? value : String(value.prefix(limit)) + "…"
+    }
+
+    private static func snippet(_ text: String, around query: String) -> String {
+        guard let range = text.range(of: query, options: .caseInsensitive) else { return "" }
+        let lower = text.index(range.lowerBound, offsetBy: -60, limitedBy: text.startIndex) ?? text.startIndex
+        let upper = text.index(range.upperBound, offsetBy: 60, limitedBy: text.endIndex) ?? text.endIndex
+        return String(text[lower..<upper])
+    }
+
     private func matchesHeaders(_ request: NetworkRequest, _ query: String) -> Bool {
         request.requestHeaders.contains { $0.key.localizedCaseInsensitiveContains(query) || $0.value.localizedCaseInsensitiveContains(query) }
             || request.responseHeaders.contains { $0.key.localizedCaseInsensitiveContains(query) || $0.value.localizedCaseInsensitiveContains(query) }
