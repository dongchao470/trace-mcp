+    private func extractCookies(_ args: JSONValue) async throws -> JSONValue {
+        let reveal = args["reveal"]?.bool ?? false
+        let limit = max(1, min(args["limit"]?.int ?? 40, 200))
+        let nameFilter = (args["name"]?.string ?? "").lowercased()
+        var requests = try await matchingRequests(args)
+        requests.sort { $0.timestamp > $1.timestamp }
+
+        struct CookieAggregate {
+            var count = 0
+            var hosts: Set<String> = []
+            var sample = ""
+            var sampleRequestID: UUID?
+            var earliest = Date.distantFuture
+            var latest = Date.distantPast
+        }
+
+        var aggregates: [String: CookieAggregate] = [:]
+        var scanned = 0
+        var requestsWithCookie = 0
+
+        for request in requests {
+            scanned += 1
+            guard let cookie = request.requestHeaders.first(where: { $0.key.caseInsensitiveCompare("Cookie") == .orderedSame })?.value else {
+                continue
+            }
+            requestsWithCookie += 1
+            let host = URL(string: request.url)?.host ?? ""
+            for pair in cookie.split(separator: ";") {
+                let item = pair.trimmingCharacters(in: .whitespaces)
+                guard let separator = item.firstIndex(of: "=") else { continue }
+                let key = String(item[..<separator])
+                let value = String(item[item.index(after: separator)...])
+                if !nameFilter.isEmpty && !key.lowercased().contains(nameFilter) { continue }
+                var aggregate = aggregates[key] ?? CookieAggregate()
+                aggregate.count += 1
+                aggregate.hosts.insert(host)
+                aggregate.earliest = min(aggregate.earliest, request.timestamp)
+                aggregate.latest = max(aggregate.latest, request.timestamp)
+                if aggregate.sample.isEmpty {
+                    aggregate.sample = value
+                    aggregate.sampleRequestID = request.id
+                }
+                aggregates[key] = aggregate
+            }
+        }
+
+        let ordered = aggregates.sorted { lhs, rhs in
+            lhs.value.count == rhs.value.count ? lhs.key < rhs.key : lhs.value.count > rhs.value.count
+        }
+        let rows: [JSONValue] = ordered.prefix(limit).map { entry in
+            let name = entry.key
+            let aggregate = entry.value
+            return .object([
+                "name": .string(name),
+                "count": .number(Double(aggregate.count)),
+                "value_length": .number(Double(aggregate.sample.count)),
+                "value": .string(reveal ? aggregate.sample : Self.maskValue(aggregate.sample)),
+                "masked": .bool(!reveal),
+                "hosts": .array(aggregate.hosts.sorted().map { .string($0) }),
+                "sample_request_id": aggregate.sampleRequestID.map { .string($0.uuidString) } ?? .null,
+                "first_seen": .string(iso(aggregate.earliest)),
+                "last_seen": .string(iso(aggregate.latest)),
+            ])
+        }
+        return .object([
+            "scanned_requests": .number(Double(scanned)),
+            "requests_with_cookie": .number(Double(requestsWithCookie)),
+            "distinct_names": .number(Double(aggregates.count)),
+            "returned": .number(Double(rows.count)),
+            "cookies": .array(rows),
+        ])
+    }
+
+    private func vpnStatus(_: JSONValue) async throws -> JSONValue {
+        let managers = try await tunnelManagers()
+        let statuses = managers.map { Self.statusName($0.connection.status) }
+        let entries = managers.map { manager -> JSONValue in
+            .object([
+                "name": .string(manager.localizedDescription),
+                "enabled": .bool(manager.isEnabled),
+                "status": .string(Self.statusName(manager.connection.status)),
+                "on_demand": .bool(manager.isOnDemandEnabled),
+            ])
+        }
+        return .object([
+            "host": .string(TraceMCPServer.shared.status.host),
+            "tunnel_count": .number(Double(managers.count)),
+            "connected": .bool(statuses.contains("connected")),
+            "tunnels": .array(entries),
+        ])
+    }
+
+    private func vpnDisconnect(_ args: JSONValue) async throws -> JSONValue {
+        guard args["confirm"]?.bool == true else {
+            throw MCPError.invalidParams("断开 VPN 需要 confirm=true")
+        }
+        let force = args["force"]?.bool ?? false
+        let managers = try await tunnelManagers()
+        var stopped = 0
+        for manager in managers {
+            switch manager.connection.status {
+            case .connected, .connecting, .reasserting:
+                manager.connection.stopVPNTunnel()
+                stopped += 1
+            default:
+                if force {
+                    manager.connection.stopVPNTunnel()
+                    stopped += 1
+                }
+            }
+        }
+        return .object([
+            "host": .string(TraceMCPServer.shared.status.host),
+            "stopped": .number(Double(stopped)),
+            "note": .string(stopped > 0 ? "已发送断开指令" : "没有处于连接状态的隧道"),
+        ])
+    }
+
+    private func tunnelManagers() async throws -> [NETunnelProviderManager] {
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<[NETunnelProviderManager], Error>) in
+            NETunnelProviderManager.loadAllFromPreferences { managers, error in
+                if let error {
+                    continuation.resume(throwing: error)
+                } else {
+                    continuation.resume(returning: managers ?? [])
+                }
+            }
+        }
+    }
+
+    private static func statusName(_ status: NEVPNStatus) -> String {
+        switch status {
+        case .connected: return "connected"
+        case .connecting: return "connecting"
+        case .disconnecting: return "disconnecting"
+        case .reasserting: return "reasserting"
+        case .disconnected: return "disconnected"
+        case .invalid: return "invalid"
+        @unknown default: return "unknown"
+        }
     }
 
