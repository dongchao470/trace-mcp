+import SwiftUI
+
+/// Renders at most one small page; reading another page never rebuilds a giant Text.
+public struct PagedBodyTextView: View {
+    public let content: String
+    @State private var pages: [String] = []
+    @State private var page = 0
+
+    public init(content: String) { self.content = content }
+
+    public var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            if pages.isEmpty {
+                ProgressView("正在准备正文…")
+            } else {
+                if pages.count > 1 {
+                    HStack(spacing: 12) {
+                        Button("上一页") { page = max(0, page - 1) }
+                            .disabled(page == 0)
+                        Text("第 \(page + 1) / \(pages.count) 页")
+                            .font(.caption)
+                            .foregroundStyle(.secondary)
+                        Button("下一页") { page = min(pages.count - 1, page + 1) }
+                            .disabled(page + 1 >= pages.count)
+                    }
+                    .buttonStyle(.bordered)
+                    Text("分页仅影响显示，不会截断实际转发的数据。")
+                        .font(.caption2)
+                        .foregroundStyle(.secondary)
+                }
+                Text(pages[min(page, pages.count - 1)])
+                    .font(.system(.caption, design: .monospaced))
+                    .textSelection(.enabled)
+                    .frame(maxWidth: .infinity, alignment: .leading)
+            }
+        }
+        .task(id: content) {
+            let input = content
+            let prepared = await Task.detached(priority: .userInitiated) {
+                BodyTextPagination.pages(input)
+            }.value
+            guard !Task.isCancelled else { return }
+            page = 0
+            pages = prepared
+        }
+    }
+}
