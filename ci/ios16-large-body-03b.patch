--- /dev/null
+++ b/TraceUI/Body/BodyTextPagination.swift
@@ -0,0 +1,22 @@
+import Foundation
+
+/// Scalar-safe pages keep even minified JSON away from an unbounded text layout.
+public enum BodyTextPagination {
+    public static let defaultPageBytes = 8 * 1024
+
+    public static func pages(_ text: String, pageBytes: Int = defaultPageBytes) -> [String] {
+        guard !text.isEmpty else { return [""] }
+        let bytes = Array(text.utf8)
+        let budget = max(4, pageBytes)
+        var result: [String] = []
+        var start = 0
+        while start < bytes.count {
+            var end = min(start + budget, bytes.count)
+            // Include the rest of a UTF-8 scalar rather than inserting replacement characters.
+            while end < bytes.count, bytes[end] & 0xC0 == 0x80 { end += 1 }
+            result.append(String(decoding: bytes[start ..< end], as: UTF8.self))
+            start = end
+        }
+        return result
+    }
+}
diff --git a/TraceUI/Body/PagedBodyTextView.swift b/TraceUI/Body/PagedBodyTextView.swift
