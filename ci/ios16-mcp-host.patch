+    /// Binds, retrying while another process still owns the loopback port: the host app
+    /// releases it when it backgrounds and the tunnel extension keeps serving afterwards.
+    public func startRetrying(
+        port: UInt16,
+        host: String,
+        interval: TimeInterval = 10,
+        remaining: Int = 90
+    ) {
+        start(port: port, host: host)
+        guard remaining > 0 else { return }
+        retryQueue.asyncAfter(deadline: .now() + interval) { [weak self] in
+            guard let self else { return }
+            if self.isListening { return }
+            self.startRetrying(port: port, host: host, interval: interval, remaining: remaining - 1)
         }
