@@ -0,0 +1,47 @@
+"""Run the exact critical-fix sources without building the iOS UI or changing app data."""
+from pathlib import Path
+import argparse
+import hashlib
+import shutil
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--prepare-only', action='store_true')
+parser.add_argument('--output', default='.critical-regressions')
+args = parser.parse_args()
+root = Path(__file__).resolve().parent.parent
+out = Path(args.output).resolve()
+sources = out / 'Sources/TraceCriticalFixes'
+tests = out / 'Tests/TraceCriticalFixesTests'
+sources.mkdir(parents=True, exist_ok=True)
+tests.mkdir(parents=True, exist_ok=True)
+files = [
+    ('TraceFeatures/Request/LegacyHTTPClientBridge.swift', sources),
+    ('TraceProxy/MITM/NIOMITMStreamingResponseDeadline.swift', sources),
+    ('TraceLogicTests/TraceCriticalNetworkingRegressionTests.swift', tests),
+]
+for name, directory in files:
+    source = root / name
+    shutil.copy2(source, directory)
+    print(hashlib.sha256(source.read_bytes()).hexdigest(), name, flush=True)
+shutil.copy2(root / 'Package.resolved', out / 'Package.resolved')
+(out / 'Package.swift').write_text('''// swift-tools-version: 6.0
+import PackageDescription
+let package = Package(name: "TraceCriticalFixes", platforms: [.macOS(.v13)], dependencies: [
+    .package(url: "https://github.com/swift-server/async-http-client.git", exact: "1.32.0"),
+    .package(url: "https://github.com/apple/swift-nio.git", from: "2.0.0"),
+    .package(url: "https://github.com/apple/swift-nio-transport-services.git", from: "1.0.0")
+], targets: [
+    .target(name: "TraceCriticalFixes", dependencies: [
+        .product(name: "AsyncHTTPClient", package: "async-http-client"),
+        .product(name: "NIOCore", package: "swift-nio"),
+        .product(name: "NIOHTTP1", package: "swift-nio")
+    ], swiftSettings: [.swiftLanguageMode(.v6)]),
+    .testTarget(name: "TraceCriticalFixesTests", dependencies: ["TraceCriticalFixes",
+        .product(name: "NIOEmbedded", package: "swift-nio"),
+        .product(name: "NIOTransportServices", package: "swift-nio-transport-services")
+    ], swiftSettings: [.swiftLanguageMode(.v5)])
+])
+''')
+if not args.prepare_only:
+    subprocess.run(['xcrun', 'swift', 'test', '-j', '4'], cwd=out, check=True)
